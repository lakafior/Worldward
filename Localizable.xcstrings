    "You don't have an upcoming trip yet. Plan one in Worldward first." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все още нямате предстоящо пътуване. Планирайте първо в Worldward."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nemáte naplánovanou žádnou cestu. Nejprve si jednu naplánujte v aplikaci Worldward."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke en kommende rejse endnu. Planlæg én i Worldward først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast noch keine anstehende Reise. Plane zuerst eine in Worldward."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε ακόμη επερχόμενο ταξίδι. Σχεδιάστε πρώτα ένα στο Worldward."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You don't have an upcoming trip yet. Plan one in Worldward first."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ankoraŭ ne havas venontan vojaĝon. Planu unu en Worldward unue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no tienes un próximo viaje. Planifica uno en Worldward primero."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul pole veel eelseisvat reisi. Planeeri esmalt üks Worldwardis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole vielä tulevaa matkaa. Suunnittele ensin yksi Worldwardissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez pas encore de voyage à venir. Planifiez-en d'abord un dans Worldward."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl turas le teacht agat go fóill. Pleanáil ceann i Worldward ar dtús."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nemate nadolazeće putovanje. Prvo planirajte jedno u Worldward."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs közelgő utazásod. Tervezz egyet először a Worldwardban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora un viaggio imminente. Pianificane uno prima in Worldward."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ今後の旅行がありません。まずWorldwardで計画してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 예정된 여행이 없습니다. 먼저 Worldward에서 계획하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar neturite artėjančios kelionės. Pirmiausia suplanuokite vieną Worldward."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jums vēl nav gaidāma ceļojuma. Vispirms izplānojiet vienu lietotnē Worldward."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Għad m'għandekx vjaġġ li ġej. Ippjana wieħed f'Worldward l-ewwel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog geen aanstaande reis. Plan er eerst een in Worldward."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz jeszcze nadchodzącej podróży. Najpierw zaplanuj jedną w Worldward."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não tem uma viagem futura. Planeje uma no Worldward primeiro."
          }
