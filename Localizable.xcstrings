        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes nomes não corresponderam a nenhum país e serão ignorados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste nume nu s-au potrivit cu nicio țară și vor fi omise."
