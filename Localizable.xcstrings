    "Countries visited, continents reached, and your share of the world." : {
      "comment" : "Widget description: travel snapshot",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посетени държави, достигнати континенти и вашият дял от света."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navštívené země, dosažené kontinenty a váš podíl na světě."
