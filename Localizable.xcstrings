    },
    "Allow Reminders access for Worldward in Settings → Privacy & Security → Reminders, then turn sync on again." : {
      "comment" : "Alert message when Reminders permission is denied while enabling sync",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете достъп до Напомняния за Worldward в Настройки → Поверителност и сигурност → Напомняния, след което включете синхронизирането отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup k Připomínkám pro Worldward v Nastavení → Soukromí a zabezpečení → Připomínky a poté synchronizaci znovu zapněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad adgang til Påmindelser for Worldward under Indstillinger → Privatliv og sikkerhed → Påmindelser, og slå derefter synkronisering til igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Worldward den Zugriff auf Erinnerungen unter Einstellungen → Datenschutz & Sicherheit → Erinnerungen und schalte die Synchronisierung dann erneut ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση στις Υπενθυμίσεις για το Worldward από Ρυθμίσεις → Απόρρητο και ασφάλεια → Υπενθυμίσεις και μετά ενεργοποιήστε ξανά τον συγχρονισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow Reminders access for Worldward in Settings → Privacy & Security → Reminders, then turn sync on again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permesu aliron al Memorigiloj por Worldward en Agordoj → Privateco kaj Sekureco → Memorigiloj, poste reŝaltu la sinkronigon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Recordatorios para Worldward en Ajustes → Privacidad y seguridad → Recordatorios y vuelve a activar la sincronización."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luba Worldwardile juurdepääs Meeldetuletustele: Seaded → Privaatsus ja turvalisus → Meeldetuletused, seejärel lülita sünkroonimine uuesti sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli Worldwardille pääsy Muistutuksiin kohdassa Asetukset → Tietosuoja ja turvallisuus → Muistutukset ja kytke synkronointi sitten uudelleen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à Rappels pour Worldward dans Réglages → Confidentialité et sécurité → Rappels, puis réactivez la synchronisation."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceadaigh rochtain Meabhrúchán do Worldward i Socruithe → Príobháideacht agus Slándáil → Meabhrúcháin, agus cas an sioncronú air arís ansin."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite pristup Podsjetnicima za Worldward u Postavke → Privatnost i sigurnost → Podsjetnici, a zatim ponovno uključite sinkronizaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezd a Worldward számára az Emlékeztetők elérését a Beállítások → Adatvédelem és biztonság → Emlékeztetők menüben, majd kapcsold be újra a szinkronizálást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Worldward l'accesso a Promemoria in Impostazioni → Privacy e sicurezza → Promemoria, poi riattiva la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → プライバシーとセキュリティ → リマインダーで、Worldwardにリマインダーへのアクセスを許可してから、同期を再度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 개인정보 보호 및 보안 → 미리 알림에서 Worldward의 미리 알림 접근을 허용한 다음 동기화를 다시 켜세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiskite Worldward pasiekti Priminimus skiltyje Nustatymai → Privatumas ir sauga → Priminimai, tada vėl įjunkite sinchronizavimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļaujiet Worldward piekļūt Atgādinājumiem sadaļā Iestatījumi → Privātums un drošība → Atgādinājumi, pēc tam atkal ieslēdziet sinhronizāciju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ippermetti aċċess għat-Tfakkiriet lil Worldward fl-Issettjar → Privatezza u Sigurtà → Tfakkiriet, imbagħad erġa' xgħel is-sinkronizzazzjoni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta toegang tot Herinneringen toe voor Worldward via Instellingen → Privacy en beveiliging → Herinneringen en zet synchronisatie daarna weer aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól aplikacji Worldward na dostęp do Przypomnień w Ustawienia → Prywatność i bezpieczeństwo → Przypomnienia, a następnie ponownie włącz synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso aos Lembretes para o Worldward em Ajustes → Privacidade e segurança → Lembretes e ative a sincronização novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso aos Lembretes para o Worldward em Definições → Privacidade e segurança → Lembretes e volte a ativar a sincronização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite accesul la Memento-uri pentru Worldward din Setări → Confidențialitate și securitate → Memento-uri, apoi reactivează sincronizarea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte aplikácii Worldward prístup k Pripomienkam v časti Nastavenia → Súkromie a bezpečnosť → Pripomienky a potom znova zapnite synchronizáciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovolite dostop do Opomnikov za Worldward v Nastavitve → Zasebnost in varnost → Opomniki, nato znova vklopite sinhronizacijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt åtkomst till Påminnelser för Worldward i Inställningar → Sekretess och säkerhet → Påminnelser och slå sedan på synkroniseringen igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”→“隐私与安全性”→“提醒事项”中允许 Worldward 访问提醒事项，然后重新开启同步。"
          }
        }
      }
    },
