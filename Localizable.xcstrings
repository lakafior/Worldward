      }
    },
    "Keeps your travel data — statuses, visits, trips, packing lists, and attachments — up to date across your devices through your personal iCloud. Takes effect the next time Worldward starts." : {
      "comment" : "Settings footer explaining the iCloud sync toggle.",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддържа данните за пътуванията ви — статуси, посещения, пътувания, списъци за багаж и прикачени файлове — актуални на всичките ви устройства чрез личния ви iCloud. Влиза в сила при следващото стартиране на Worldward."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržuje vaše cestovní data — stavy, návštěvy, cesty, balicí seznamy a přílohy — aktuální na všech vašich zařízeních prostřednictvím vašeho osobního iCloudu. Projeví se při příštím spuštění Worldwardu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder dine rejsedata — statusser, besøg, rejser, pakkelister og bilag — opdateret på tværs af dine enheder via din personlige iCloud. Træder i kraft, næste gang Worldward starter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält deine Reisedaten — Status, Besuche, Reisen, Packlisten und Anhänge — über deine persönliche iCloud auf allen deinen Geräten aktuell. Wird beim nächsten Start von Worldward wirksam."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρεί τα ταξιδιωτικά σας δεδομένα — καταστάσεις, επισκέψεις, ταξίδια, λίστες αποσκευών και συνημμένα — ενημερωμένα σε όλες τις συσκευές σας μέσω του προσωπικού σας iCloud. Ισχύει από την επόμενη εκκίνηση του Worldward."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps your travel data — statuses, visits, trips, packing lists, and attachments — up to date across your devices through your personal iCloud. Takes effect the next time Worldward starts."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenas viajn vojaĝajn datumojn — statusojn, vizitojn, vojaĝojn, pakolistojn kaj kunsendaĵojn — ĝisdataj tra viaj aparatoj per via persona iCloud. Ekvalidas ĉe la sekva lanĉo de Worldward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene tus datos de viaje — estados, visitas, viajes, listas de equipaje y adjuntos — actualizados en todos tus dispositivos a través de tu iCloud personal. Se aplica la próxima vez que se inicie Worldward."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoiab sinu reisiandmed — olekud, külastused, reisid, pakkimisnimekirjad ja manused — kõigis sinu seadmetes ajakohasena sinu isikliku iCloudi kaudu. Jõustub Worldwardi järgmisel käivitamisel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitää matkatietosi — tilat, vierailut, matkat, pakkauslistat ja liitteet — ajan tasalla kaikilla laitteillasi henkilökohtaisen iCloudisi kautta. Tulee voimaan, kun Worldward käynnistetään seuraavan kerran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde vos données de voyage — statuts, visites, voyages, listes de bagages et pièces jointes — à jour sur tous vos appareils via votre iCloud personnel. Prend effet au prochain démarrage de Worldward."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinníonn sé do shonraí taistil — stádais, cuairteanna, turais, liostaí pacála agus ceangaltáin — cothrom le dáta ar do ghléasanna go léir trí do iCloud pearsanta. Tiocfaidh sé i bhfeidhm an chéad uair eile a thosóidh Worldward."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Održava vaše podatke o putovanjima — statuse, posjete, putovanja, popise za pakiranje i privitke — ažurnima na svim vašim uređajima putem vašeg osobnog iClouda. Primjenjuje se pri sljedećem pokretanju Worldwarda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprakészen tartja utazási adataidat — állapotokat, látogatásokat, utazásokat, csomagolólistákat és mellékleteket — az összes eszközödön a személyes iCloudodon keresztül. A Worldward következő indításakor lép életbe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene i tuoi dati di viaggio — stati, visite, viaggi, liste bagagli e allegati — aggiornati su tutti i tuoi dispositivi tramite il tuo iCloud personale. Ha effetto al prossimo avvio di Worldward."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行データ（ステータス、訪問、旅行、パッキングリスト、添付ファイル）を、個人のiCloudを通じてすべてのデバイスで最新の状態に保ちます。次回Worldwardを起動したときに有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 데이터(상태, 방문, 여행, 짐 목록, 첨부 파일)를 개인 iCloud를 통해 모든 기기에서 최신 상태로 유지합니다. 다음에 Worldward를 실행할 때 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų kelionių duomenys — būsenos, apsilankymai, kelionės, daiktų sąrašai ir priedai — nuolat atnaujinami visuose jūsų įrenginiuose per jūsų asmeninį iCloud. Įsigalioja kitą kartą paleidus Worldward."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uztur jūsu ceļojumu datus — statusus, apmeklējumus, ceļojumus, mantu sarakstus un pielikumus — aktuālus visās jūsu ierīcēs, izmantojot jūsu personīgo iCloud. Stājas spēkā nākamajā Worldward palaišanas reizē."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iżomm id-data tal-ivvjaġġar tiegħek — statuses, żjarat, vjaġġi, listi tal-ippakkjar u annessi — aġġornata fuq l-apparati kollha tiegħek permezz tal-iCloud personali tiegħek. Jidħol fis-seħħ id-darba li jmiss li jinfetaħ Worldward."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt je reisgegevens — statussen, bezoeken, reizen, paklijsten en bijlagen — up-to-date op al je apparaten via je persoonlijke iCloud. Wordt van kracht bij de volgende start van Worldward."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuje Twoje dane podróży — statusy, wizyty, podróże, listy do spakowania i załączniki — aktualne na wszystkich Twoich urządzeniach za pośrednictwem Twojego osobistego iCloud. Zacznie obowiązywać przy następnym uruchomieniu Worldward."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém seus dados de viagem — status, visitas, viagens, listas de bagagem e anexos — atualizados em todos os seus dispositivos por meio do seu iCloud pessoal. Entra em vigor na próxima vez que o Worldward for iniciado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém os seus dados de viagem — estados, visitas, viagens, listas de bagagem e anexos — atualizados em todos os seus dispositivos através do seu iCloud pessoal. Entra em vigor na próxima vez que o Worldward for iniciado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți menține datele de călătorie — stări, vizite, călătorii, liste de bagaje și atașamente — actualizate pe toate dispozitivele tale prin iCloud-ul tău personal. Se aplică la următoarea pornire a aplicației Worldward."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržiava vaše cestovné údaje — stavy, návštevy, cesty, baliace zoznamy a prílohy — aktuálne na všetkých vašich zariadeniach prostredníctvom vášho osobného iCloudu. Prejaví sa pri ďalšom spustení Worldwardu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranja vaše potovalne podatke — statuse, obiske, potovanja, sezname za pakiranje in priloge — posodobljene v vseh vaših napravah prek vašega osebnega iClouda. Velja ob naslednjem zagonu aplikacije Worldward."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håller dina resedata — statusar, besök, resor, packlistor och bilagor — uppdaterade på alla dina enheter via din personliga iCloud. Träder i kraft nästa gång Worldward startas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过你的个人 iCloud，让你的旅行数据（状态、到访、旅程、行李清单和附件）在所有设备上保持同步。将在下次启动 Worldward 时生效。"
          }
        }
      }
    },
