          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητήστε αξιοθέατα και μέρη για επίσκεψη σε αυτή τη στάση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Search for sights and spots to visit at this stop."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serĉu vidindaĵojn kaj lokojn por viziti ĉe ĉi tiu halto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca lugares y sitios para visitar en esta parada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otsige vaatamisväärsusi ja kohti, mida selles peatuses külastada."
