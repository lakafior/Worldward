    "Bags and cases are shared across all your trips.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Batohy a kufry jsou sdíleny napříč všemi vašimi cestami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taschen und Koffer werden geräteübergreifend für alle deine Reisen genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Bags and cases are shared across all your trips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bolsas y maletas se comparten en todos tus viajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sacs et valises sont partagés entre tous vos voyages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A táskák és bőröndök meg vannak osztva az összes utazása között."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Borse e valigie sono condivise tra tutti i tuoi viaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッグとケースはすべての旅行で共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가방과 케이스는 모든 여행에서 공유됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaże są widoczne we wszystkich podróżach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolsas e malas são compartilhadas entre todas as suas viagens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolsas e malas são compartilhadas entre todas as suas viagens."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tašky a kufre sú zdieľané naprieč všetkými vašimi cestami."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包袋和箱子在您所有旅行中共享。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakoj kaj kestoj estas komunaj inter ĉiuj viaj vojaĝoj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasker og kufferter deles på tværs af alle dine rejser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väskor och resväskor delas mellan alla dina resor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laukut ja matkalaukut jaetaan kaikkien matkojesi kesken."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotid ja pagasid jagatakse kõigi sinu reiside vahel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassen en koffers worden gedeeld over al je reizen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чантите и куфарите се споделят между всички ваши пътувания."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torbe i kovčezi dijele se na svim vašim putovanjima."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τσάντες και οι βαλίτσες μοιράζονται σε όλα τα ταξίδιά σας."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gențile și valizele sunt partajate între toate călătoriile dumneavoastră."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Torbe in kovčki so deljene med vsemi vašimi potovanji."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Somas un koferi tiek koplietoti visos jūsu ceļojumos."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Krepšiai ir lagaminai yra bendri visoms jūsų kelionėms."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roinntear málaí agus cáisí ar fud do thurais go léir."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Basktijiet u valigġi huma kondiviżi fil-vjaġġi kollha tiegħek."
          }
        }
      }
    },
