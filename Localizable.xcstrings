    "A single trip at least this long marks the country as “Lived”.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna cesta v délce alespoň této doby označí zemi jako „Žil(a)“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einzelne Reise dieser Mindestdauer markiert das Land als „Gelebt\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A single trip at least this long marks the country as “Lived”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo viaje de al menos esta duración marca el país como «Vivido»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul voyage d’au moins cette durée marque le pays comme « Vécu »."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy ennyi ideig tartó utazás „Ott élt”-ként jelöli meg az országot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singolo viaggio di almeno questa durata segna il paese come «Vissuto»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間以上の旅行が１回あれば、その国は「住んだ」とマークされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간 이상의 단일 여행이면 해당 국가가 “살아본”으로 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedyncza podróż trwająca co najmniej tyle oznacza kraj jako „Mieszkałem”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma única viagem de pelo menos esta duração marca o país como «Morei»."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma única viagem de pelo menos esta duração marca o país como «Morei»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna cesta v trvaní aspoň tohto času označí krajinu ako „Žil(a)“."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次旅行达到此时长即将该国标记为“居住过”。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Unuopa vojaĝo tiom longa markas la landon kiel “Loĝis”."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enkelt rejse på mindst denne længde markerer landet som “Boet”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En enskild resa på minst denna längd markerar landet som “Bodde”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksittäinen matka, joka on vähintään näin pitkä, merkitsee maan asutuksi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üksik reis vähemalt nii kaua tähistab riiki kui “Elamas”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een enkele reis van ten minste deze lengte markeert het land als “Gewoond”."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "A single trip at least this long marks the country as “Lived”."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "A single trip at least this long marks the country as “Lived”."
          }
        },
        "el": {
