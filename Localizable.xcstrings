    "Only scan photos newer than the latest imported visit." : {
      "comment" : "Explains the 'Add new only' photo import scan mode",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканиране само на по-нови снимки от последното импортирано посещение."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenovat pouze fotografie novější než poslední importovaná návštěva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan kun billeder nyere end det seneste importerede besøg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Fotos scannen, die neuer als der letzte importierte Besuch sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σάρωση μόνο φωτογραφιών νεότερων από την τελευταία εισαγόμενη επίσκεψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only scan photos newer than the latest imported visit."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skani nur fotojn pli novajn ol la lasta importita vizito."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escane solo fotos más recientes que la última visita importada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
