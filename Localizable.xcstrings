    "Plan a trip in Worldward on your iPhone and turn on iCloud sync — it will appear here." : {
      "comment" : "Watch empty state message shown when no trips have synced yet",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планирайте пътуване в Worldward на вашия iPhone и включете iCloud синхронизация — ще се появи тук."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánujte cestu ve Worldward na svém iPhonu a zapněte iCloud sync — objeví se zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlæg en tur i Worldward på din iPhone og slå iCloud-synkronisering til — den vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane eine Reise in Worldward auf deinem iPhone und aktiviere die iCloud-Synchronisierung — sie wird hier angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προγραμματίστε ένα ταξίδι στο Worldward στο iPhone σας και ενεργοποιήστε τον συγχρονισμό iCloud — θα εμφανιστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Plan a trip in Worldward on your iPhone and turn on iCloud sync — it will appear here."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planu vojaĝon en Worldward sur via iPhone kaj ŝaltu iCloud-sinkronigon — ĝi aperos ĉi tie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planea un viaje en Worldward en tu iPhone y activa la sincronización de iCloud — aparecerá aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeeri reis Worldwardis oma iPhone'is ja lülita sisse iCloudi sünkroniseerimine — see kuvatakse siin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnittele matka Worldwardissa iPhonellasi ja ota iCloud-synkronointi käyttöön — se näkyy täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez un voyage dans Worldward sur votre iPhone et activez la synchronisation iCloud — il apparaîtra ici."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pleanáil turas in Worldward ar do iPhone agus cas ar shioncronú iCloud — taispeánfar é anseo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planirajte putovanje u Worldwardu na svom iPhoneu i uključite iCloud sinkronizaciju — pojavit će se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tervezz egy utazást a Worldwardban az iPhone-odon, és kapcsold be az iCloud szinkronizálást — itt fog megjelenni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica un viaggio in Worldward sul tuo iPhone e attiva la sincronizzazione iCloud — apparirà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのWorldwardで旅を計画し、iCloud同期をオンにすると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Worldward에서 여행을 계획하고 iCloud 동기화를 켜면 여기에 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suplanuokite kelionę Worldward savo iPhone ir įjunkite iCloud sinchronizavimą — ji atsiras čia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieplānojiet ceļojumu Worldward savā iPhone un ieslēdziet iCloud sinhronizāciju — tas parādīsies šeit."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ippjana vjaġġ f'Worldward fuq l-iPhone tiegħek u ixgħel is-sinkronizzazzjoni tal-iCloud — jidher hawn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan een reis in Worldward op je iPhone en zet iCloud-synchronisatie aan — het verschijnt hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanuj podróż w Worldward na swoim iPhonie i włącz synchronizację iCloud — pojawi się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeje uma viagem no Worldward no seu iPhone e ative a sincronização do iCloud — ela aparecerá aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeie uma viagem no Worldward no seu iPhone e ative a sincronização do iCloud — aparecerá aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifică o excursie în Worldward pe iPhone și activează sincronizarea iCloud — va apărea aici."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánujte si cestu v Worldward na svojom iPhone a zapnite synchronizáciu iCloud — zobrazí sa tu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načrtujte potovanje v Worldward na svojem iPhoneu in vklopite iCloud sinhronizacijo — prikazalo se bo tukaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planera en resa i Worldward på din iPhone och slå på iCloud-synkronisering — den visas här."
          }
