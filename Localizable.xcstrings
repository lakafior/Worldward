      }
    },
    "Plan a trip in Worldward, then pick it here." : {
      "comment" : "Trip widget: empty-state hint below “No trip to show”",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планирайте пътуване в Worldward, после го изберете тук."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánujte cestu ve Worldward a pak ji zde vyberte."
          }
        },
        "da" : {
