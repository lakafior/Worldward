    "Describe a trip in your own words and Worldward extracts the countries and dates for you to confirm.": {
      "comment": "Description of the intent that lets the user describe a trip and Worldward extracts the countries and dates for them to confirm.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe eine Reise in eigenen Worten und Worldward extrahiert die Länder und Daten zur Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Describe a trip in your own words and Worldward extracts the countries and dates for you to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe un viaje con tus propias palabras y Worldward extrae los países y fechas para que los confirmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez un voyage avec vos propres mots et Worldward extrait les pays et les dates pour confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi un viaggio con le tue parole e Worldward estrae i paesi e le date da confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行を自分の言葉で説明すると、Worldwardが国と日付を抽出して確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행을 스스로 설명하면 Worldward가 국가와 날짜를 추출하여 확인할 수 있게 해줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz podróż własnymi słowami, a Worldward wyodrębni kraje i daty do potwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma viagem com suas próprias palavras e o Worldward extrai os países e datas para você confirmar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma viagem com suas próprias palavras e o Worldward extrai os países e datas para você confirmar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用您的话描述一次旅行，Worldward 会提取国家和日期供您确认。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popište cestu vlastními slovy a Worldward extrahuje země a data k potvrzení."
          }
        }
      }
    },
