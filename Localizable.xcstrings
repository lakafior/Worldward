    "This device can't run the on-device parser.": {
      "comment": "A message displayed when the on-device parser isn't available.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nemůže spouštět místní analyzátor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann den geräteinternen Parser nicht ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This device can't run the on-device parser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede ejecutar el analizador local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas exécuter l’analyseur local."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az eszköz nem képes az eszközön lévő elemző futtatására."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può eseguire il parser locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではデバイス上のパーサーを実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 기기상 파서를 실행할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie może uruchomić lokalnego parsera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não pode executar o analisador local."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não pode executar o analisador local."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zariadenie nemôže spúšťať miestny analyzátor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备无法运行本地解析器。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ĉi tiu aparato ne povas funkciigi la sur-aparatan analizilon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed kan ikke køre den lokale parser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten kan inte köra den lokala parsern."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite ei voi suorittaa laitteen omaa jäsentä."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See seade ei saa käivitada seadmesisest parserit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan de parser op het apparaat niet uitvoeren."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това устройство не може да пусне локалния анализатор."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uređaj ne može pokrenuti lokalni parser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συσκευή δεν μπορεί να εκτελέσει τον τοπικό αναλυτή."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu poate rula analizatorul local."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta naprava ne more zagnati lokalnega razčlenjevalnika."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī ierīce nevar palaist ierīcē esošo parseri."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis įrenginys negali paleisti įrenginyje esančio parserio."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir leis an ghléas seo an parsálaí ar an ngléas a rith."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan it-tagħmir ma jistax imexxi l-parser fuq it-tagħmir."
          }
        }
      }
    },
