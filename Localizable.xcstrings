    "These photos didn't fall inside any country — often a small island. Assign each to a country, or leave it to skip those photos." : {
      "comment" : "A description of the footer for the list of locations that haven't been assigned to a country.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fotos liegen in keinem Land – oft eine kleine Insel. Ordne jedes einem Land zu oder lasse sie aus, um die Fotos zu überspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These photos didn't fall inside any country — often a small island. Assign each to a country, or leave it to skip those photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos no caen dentro de ningún país — a menudo una isla pequeña. Asigna cada una a un país, o déjalas para saltar esas fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces photos ne se situent dans aucun pays — souvent une petite île. Attribuez chacune à un pays, ou laissez pour ignorer ces photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste foto non cadono all’interno di alcun paese — spesso una piccola isola. Assegna ciascuna a un paese o lascia per saltare quelle foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの写真はどの国内にも位置していません—小さな島であることがよくあります。各写真を国に割り当てるか、そのままにしてスキップすることができます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te zdjęcia nie znajdują się w granicach żadnego kraju — często to mała wyspa. Przypisz każde do kraju lub pozostaw, aby pominąć te zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos não estão dentro de nenhum país — muitas vezes uma pequena ilha. Atribua cada uma a um país, ou deixe para pular essas fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos não estão dentro de nenhum país — muitas vezes uma pequena ilha. Atribua cada uma a um país, ou deixe para pular essas fotos."
          }
        }
      }
    },
