    "Ask me anything about the countries you've visited — on-device, private to you.": {
      "comment": "A description of the functionality of the Travel Chat view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mich alles zu den Ländern, die du besucht hast – auf dem Gerät, privat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntame lo que quieras sobre los países que has visitado — en el dispositivo, privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-moi tout sur les pays que vous avez visités — sur l’appareil, en toute confidentialité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedimi tutto sui paesi che hai visitato — sul dispositivo, privato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj o wszystko dotyczące krajów, które odwiedziłeś — na urządzeniu, prywatnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-me qualquer coisa sobre os países que você visitou — no dispositivo, privado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-me qualquer coisa sobre os países que você visitou — no dispositivo, privado."
          }
        }
      }
    },
