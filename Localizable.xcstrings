        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가를 방문한 것으로 표시하거나 사진에서 가져와 성과를 해제해보세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažymėkite šalis kaip aplankytas arba importuokite iš nuotraukų, kad pradėtumėte gauti pasiekimus."
