    "Save a trip's packing list as a template to reuse it on future trips." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазване на списъка за опаковка на пътуване като шаблон за повторна употреба при бъдещи пътувания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložit balicí seznam výletu jako šablonu pro opětovné použití na budoucích cestách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en rejses pakkeliste som skabelon til genbrug på fremtidige rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Packliste einer Reise als Vorlage speichern, um sie auf zukünftigen Reisen wiederzuverwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε τη λίστα συσκευής ενός ταξιδιού ως πρότυπο για επαναχρησιμοποίηση σε μελλοντικά ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save a trip's packing list as a template to reuse it on future trips."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konservi la pakliston de vojaĝo kiel ŝablonon por reuzi ĝin por estontaj vojaĝoj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar la lista de equipaje de un viaje como plantilla para reutilizarla en viajes futuros."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvesta reisi pakkimisnimekiri mallina, et seda tulevastel reisidel uuesti kasutada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna matkan pakkauslista malliksi käytettäväksi uudelleen tulevilla matkoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer la liste de bagages d'un voyage comme modèle pour la réutiliser lors de futurs voyages."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabháil liosta pacála turais mar theimpléad le hathúsáid ar thurais amach anseo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremi popis za pakiranje putovanja kao predložak za ponovno korištenje na budućim putovanjima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
