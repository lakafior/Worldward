    "Opens your travel dashboard with visited countries, achievements, and continent progress.": {
      "comment": "Description of the intent to open the travel stats interface.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře váš cestovní přehled s navštívenými zeměmi, úspěchy a pokrokem na kontinentech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet dein Reise-Dashboard mit besuchten Ländern, Erfolgen und Kontinent-Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Opens your travel dashboard with visited countries, achievements, and continent progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tu panel de viaje con países visitados, logros y progreso del continente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre votre tableau de bord de voyage avec les pays visités, les succès et la progression sur les continents."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja az utazási irányítópultot a meglátogatott országokkal, az eredményekkel és a kontinensek előrehaladásával."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il tuo dashboard di viaggio con paesi visitati, obiettivi e progresso del continente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行ダッシュボードを開き、訪問した国、実績、大陸の進捗を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문한 국가, 성과, 대륙 진행도를 표시하는 여행 대시보드를 엽니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera pulpit podróży z odwiedzonymi krajami, osiągnięciami i postępem na kontynentach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre seu painel de viagens com países visitados, conquistas e progresso do continente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre seu painel de viagens com países visitados, conquistas e progresso do continente."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvára váš cestovný prehľad s navštívenými krajinami, úspechmi a pokrokom na kontinentoch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开您的旅行仪表盘，显示已访问的国家、成就和大洲进度。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Malfermas vian vojaĝan panelon kun vizititaj landoj, atingoj kaj kontinenta progreso."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner dit rejseoverblik med besøgte lande, præstationer og kontinentfremskridt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar din resedashboard med besökta länder, prestationer och kontinentframsteg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa matkakoosteesi vierailluista maista, saavutuksista ja mantereen edistymisestä."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avab sinu reiside koondvaate külastatud riikide, saavutuste ja mandrite edenemisega."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent je reisdashboard met bezochte landen, prestaties en continentvoortgang."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отваря вашето табло за пътувания с посетени държави, постижения и напредък на континенти."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara vašu putnu ploču s posjećenim državama, postignućima i napretkom na kontinentima."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει την πίνακα ταξιδίου με τις επισκεφθείσες χώρες, τα επιτεύγματα και την πρόοδο ηπείρου."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide tabloul de bord de călătorie cu țări vizitate, realizări și progres pe continente."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre vašo nadzorno ploščo potovanj z obiskanimi državami, dosežki in napredkom na celinah."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atver jūsu ceļojumu paneli ar apmeklētajām valstīm, sasniegumiem un kontinentu progresu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidaro jūsų kelionių skydelį su aplankytomis šalimis, pasiekimais ir žmynų progresu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Osclaíonn sé do dheais taistil le tíortha ar tugadh cuairt orthu, éachtaí, agus dul chun cinn na mór-roinne."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiftaħ id-daxxbord tal-ivvjaġġar tiegħek bil-pajjiżi żurati, kisbiet, u progress tal-kontinent."
          }
        }
      }
    },
