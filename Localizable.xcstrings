    "Try naming the countries you visited more directly.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste jmenovat země, které jste navštívili, příměji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, die besuchten Länder direkter zu nennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Try naming the countries you visited more directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta nombrar los países que visitaste de forma más directa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de nommer les pays que vous avez visités plus directement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbálja meg közvetlenebbül megnevezni a meglátogatott országokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a nominare i paesi che hai visitato più direttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問した国をより直接的に指定してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문한 국가를 더 직접적으로 명시해보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj wymienić odwiedzone kraje bardziej bezpośrednio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente nomear os países que você visitou de forma mais direta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente nomear os países que você visitou de forma mais direta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúste vymenovať krajiny, ktoré ste navštívili, priamejšie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请直接说出您去过的国家名称。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Provu nomi la landojn kiujn vi vizitis pli rekte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv at nævne de lande du besøgte mere direkte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök att nämna länderna du besökte mer direkt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritä mainita vierailemasi maat suoremmin."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi nimetada külastatud riike otsekohesemalt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer de landen die je hebt bezocht directer te benoemen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опитайте да назовете посетените от вас държави по-прямо."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte izravnije navesti države koje ste posjetili."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε να ονομάσετε τις χώρες που επισκεφθήκατε πιο άμεσα."
          }
        },
        "ro": {
          "stringUnit": {
