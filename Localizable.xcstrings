    "This backup holds %lld countries and %lld trips, and will update the matching countries in Worldward." : {
      "comment" : "Confirmation body when there are no existing trips to replace",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това резервно копие съдържа %lld държави и %lld пътувания и ще актуализира съответните държави в Worldward."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato záloha obsahuje %lld zemí a %lld cest a aktualizuje odpovídající země ve Worldward."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sikkerhedskopi indeholder %lld lande og %lld rejser og opdaterer de tilsvarende lande i Worldward."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup enthält %lld Länder und %lld Reisen und aktualisiert die passenden Länder in Worldward."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αντίγραφο ασφαλείας περιέχει %lld χώρες και %lld ταξίδια και θα ενημερώσει τις αντίστοιχες χώρες στο Worldward."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This backup holds %lld countries and %lld trips, and will update the matching countries in Worldward."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉi tiu sekurkopio enhavas %lld landojn kaj %lld vojaĝojn, kaj ĝisdatigos la kongruajn landojn en Worldward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad contiene %lld países y %lld viajes, y actualizará los países correspondientes en Worldward."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See varukoopia sisaldab %lld riiki ja %lld reisi ning värskendab Worldwardis vastavaid riike."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä varmuuskopio sisältää %lld maata ja %lld matkaa, ja se päivittää vastaavat maat Worldwardissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde contient %lld pays et %lld voyages, et mettra à jour les pays correspondants dans Worldward."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá %lld tír agus %lld turas sa chúltaca seo, agus nuashonróidh sé na tíortha comhoiriúnacha in Worldward."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova sigurnosna kopija sadrži %lld zemalja i %lld putovanja te će ažurirati odgovarajuće zemlje u Worldwardu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a biztonsági mentés %lld országot és %lld utazást tartalmaz, és frissíti a megfelelő országokat a Worldwardban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup contiene %lld paesi e %lld viaggi e aggiornerà i paesi corrispondenti in Worldward."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップには %lld か国と %lld 件の旅行が含まれています。Worldward 内の該当する国が更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업에는 %lld개국과 %lld개의 여행이 있으며, Worldward의 해당 국가가 업데이트됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šioje atsarginėje kopijoje yra %lld šalių ir %lld kelionių; ji atnaujins atitinkamas šalis Worldward programoje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šajā dublējumā ir %lld valstis un %lld ceļojumi, un tas atjauninās atbilstošās valstis lietotnē Worldward."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din il-kopja ta' sigurtà fiha %lld pajjiżi u %lld vjaġġi, u se taġġorna l-pajjiżi korrispondenti f'Worldward."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze reservekopie bevat %lld landen en %lld reizen en werkt de bijbehorende landen in Worldward bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia zapasowa zawiera %lld krajów i %lld podróży oraz zaktualizuje pasujące kraje w Worldward."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup contém %lld países e %lld viagens e atualizará os países correspondentes no Worldward."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia de segurança contém %lld países e %lld viagens e irá atualizar os países correspondentes no Worldward."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această copie de rezervă conține %lld țări și %lld călătorii și va actualiza țările corespunzătoare în Worldward."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto záloha obsahuje %lld krajín a %lld ciest a aktualizuje príslušné krajiny vo Worldward."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta varnostna kopija vsebuje %lld držav in %lld potovanj ter bo posodobila ustrezne države v Worldwardu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna säkerhetskopia innehåller %lld länder och %lld resor och uppdaterar motsvarande länder i Worldward."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份包含 %lld 个国家和 %lld 次旅行，将更新 Worldward 中相匹配的国家。"
          }
        }
      }
    },
    "This backup holds %lld countries and %lld trips. Importing it replaces the %lld trips already in Worldward, along with their stops and packing lists. This can't be undone." : {
      "comment" : "Confirmation body when the restore will delete existing trips",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това резервно копие съдържа %lld държави и %lld пътувания. Импортирането ще замени %lld пътувания, които вече са в Worldward, заедно с техните спирки и списъци за багаж. Това действие е необратимо."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato záloha obsahuje %lld zemí a %lld cest. Import nahradí %lld cest, které už jsou ve Worldward, včetně jejich zastávek a seznamů věcí. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sikkerhedskopi indeholder %lld lande og %lld rejser. Import erstatter de %lld rejser, der allerede findes i Worldward, sammen med deres stop og paklister. Dette kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup enthält %lld Länder und %lld Reisen. Beim Import werden die %lld Reisen, die bereits in Worldward vorhanden sind, samt ihren Stationen und Packlisten ersetzt. Das lässt sich nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αντίγραφο ασφαλείας περιέχει %lld χώρες και %lld ταξίδια. Η εισαγωγή θα αντικαταστήσει τα %lld ταξίδια που υπάρχουν ήδη στο Worldward, μαζί με τις στάσεις και τις λίστες αποσκευών τους. Η ενέργεια δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This backup holds %lld countries and %lld trips. Importing it replaces the %lld trips already in Worldward, along with their stops and packing lists. This can't be undone."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉi tiu sekurkopio enhavas %lld landojn kaj %lld vojaĝojn. Importi ĝin anstataŭigos la %lld vojaĝojn jam en Worldward, kune kun iliaj haltoj kaj paklistoj. Tio ne estas malfarebla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad contiene %lld países y %lld viajes. Al importarla se sustituirán los %lld viajes que ya hay en Worldward, junto con sus paradas y listas de equipaje. Esta acción no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See varukoopia sisaldab %lld riiki ja %lld reisi. Importimine asendab %lld reisi, mis on juba Worldwardis, koos nende peatuste ja pakkimisnimekirjadega. Seda ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä varmuuskopio sisältää %lld maata ja %lld matkaa. Tuonti korvaa %lld matkaa, jotka ovat jo Worldwardissa, sekä niiden pysähdykset ja pakkauslistat. Tätä ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde contient %lld pays et %lld voyages. L'importer remplacera les %lld voyages déjà présents dans Worldward, ainsi que leurs étapes et listes de bagages. Cette action est irréversible."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá %lld tír agus %lld turas sa chúltaca seo. Cuirfidh an iompórtáil %lld turas atá in Worldward cheana féin ina n-ionad, mar aon lena stadanna agus a liostaí pacála. Ní féidir é seo a chealú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova sigurnosna kopija sadrži %lld zemalja i %lld putovanja. Uvoz će zamijeniti %lld putovanja koja su već u Worldwardu, zajedno s njihovim postajama i popisima za pakiranje. To se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a biztonsági mentés %lld országot és %lld utazást tartalmaz. Az importálás lecseréli a Worldwardban már meglévő %lld utazást, azok megállóival és csomaglistáival együtt. Ez a művelet nem vonható vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup contiene %lld paesi e %lld viaggi. L'importazione sostituirà i %lld viaggi già presenti in Worldward, insieme alle loro tappe e liste bagagli. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップには %lld か国と %lld 件の旅行が含まれています。読み込むと、Worldward にある %lld 件の旅行が、経由地とパッキングリストごと置き換えられます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업에는 %lld개국과 %lld개의 여행이 있습니다. 가져오면 Worldward에 이미 있는 %lld개의 여행이 경유지 및 짐 목록과 함께 대체됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šioje atsarginėje kopijoje yra %lld šalių ir %lld kelionių. Importavus bus pakeistos %lld kelionės, jau esančios Worldward programoje, kartu su jų sustojimais ir daiktų sąrašais. Šio veiksmo anuliuoti negalima."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šajā dublējumā ir %lld valstis un %lld ceļojumi. Importēšana aizstās %lld ceļojumus, kas jau ir lietotnē Worldward, kopā ar to pieturām un iepakošanas sarakstiem. Šo darbību nevar atsaukt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din il-kopja ta' sigurtà fiha %lld pajjiżi u %lld vjaġġi. L-importazzjoni tissostitwixxi l-%lld vjaġġi li diġà hemm f'Worldward, flimkien mal-waqfiet u l-listi tal-ippakkjar tagħhom. Dan ma jistax jitreġġa' lura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze reservekopie bevat %lld landen en %lld reizen. Bij het importeren worden de %lld reizen die al in Worldward staan vervangen, samen met hun stops en paklijsten. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia zapasowa zawiera %lld krajów i %lld podróży. Zaimportowanie jej zastąpi %lld podróży już zapisanych w Worldward wraz z ich przystankami i listami pakowania. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup contém %lld países e %lld viagens. Importá-lo substituirá as %lld viagens já existentes no Worldward, junto com suas paradas e listas de bagagem. Isso não pode ser desfeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia de segurança contém %lld países e %lld viagens. Importá-la substituirá as %lld viagens já existentes no Worldward, juntamente com as suas paragens e listas de bagagem. Esta ação não pode ser anulada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această copie de rezervă conține %lld țări și %lld călătorii. Importarea va înlocui cele %lld călătorii deja existente în Worldward, împreună cu opririle și listele lor de bagaje. Această acțiune nu poate fi anulată."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto záloha obsahuje %lld krajín a %lld ciest. Import nahradí %lld ciest, ktoré sú už vo Worldward, vrátane ich zastávok a zoznamov vecí. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta varnostna kopija vsebuje %lld držav in %lld potovanj. Uvoz bo zamenjal %lld potovanj, ki so že v Worldwardu, skupaj z njihovimi postanki in seznami za pakiranje. Tega ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna säkerhetskopia innehåller %lld länder och %lld resor. Importen ersätter de %lld resor som redan finns i Worldward, tillsammans med deras stopp och packlistor. Detta kan inte ångras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份包含 %lld 个国家和 %lld 次旅行。导入后，Worldward 中已有的 %lld 次旅行及其途经点和行李清单将被替换。此操作无法撤销。"
          }
        }
      }
    },
