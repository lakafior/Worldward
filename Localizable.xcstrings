    "Mark countries as visited or import from Photos to start earning achievements.": {
      "comment": "A description of the content that is available when the user has not yet traveled.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte země jako navštívené nebo importujte z fotek a začněte získávat úspěchy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Länder als besucht oder importiere aus Fotos, um Erfolge zu sammeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Mark countries as visited or import from Photos to start earning achievements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca países como visitados o importa desde Fotos para comenzar a ganar logros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez des pays comme visités ou importez depuis Photos pour commencer à gagner des succès."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje meg az országokat meglátogatottként vagy importáljon a Fotókból, és kezdje el gyűjteni az eredményeket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna paesi come visitati o importa da Foto per iniziare a guadagnare obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国を訪問済みとしてマークするか、写真からインポートして実績を獲得しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가를 방문한 것으로 표시하거나 사진에서 가져와 성과를 해제해보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz kraje jako odwiedzone lub zaimportuj ze Zdjęć, aby zacząć zdobywać osiągnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque países como visitados ou importe das Fotos para começar a ganhar conquistas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque países como visitados ou importe das Fotos para começar a ganhar conquistas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte krajiny ako navštívené alebo importujte z fotiek a začnite získavať úspechy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将国家标记为已访问，或从照片导入以开始解锁成就。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Marku landojn kiel vizititaj aŭ importu de Fotoj por komenci gajni atingojn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér lande som besøgt eller importer fra billeder for at begynde at optjene præstationer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera länder som besökta eller importera från foton för att börja tjäna prestationer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse maita vierailluiksi tai tuo kuvista aloittaaksesi saavutusten ansaitsemisen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märgi riigid külastatuks või impordi fotodest, et hakata saavutusi koguma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer landen als bezocht of importeer uit foto's om prestaties te verdienen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маркирайте държави като посетени или внесете от снимки, за да започнете да печелите постижения."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite države kao posjećene ili uvezite iz fotografija kako biste poČeli zarađivati postignuća."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε χώρες ως επισκεφθείσες ή εισάγετε από Φωτογραφίες για να αρχίσετε να κερδίζετε επιτεύγματα."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcați țări ca vizitate sau importați din fotografii pentru a începe să câștigați realizări."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite države kot obiskane ali uvozite iz fotografij, da začnete osvajati dosežke."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atzīmējiet valstis kā apmeklētas vai importējiet no fotogrāfijām, lai sāktu iegūt sasniegumus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pažymėkite šalis kaip aplankytas arba importuokite iš nuotraukų, kad pradėtumėte gauti pasiekimus."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcáil tíortha mar thug tú cuairt orthu nó iompórtáil ó Ghrianghraif chun tús a bhaint le éachtaí a thuilleamh."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Immarka pajjiżi bħala żurati jew importa mir-Ritratti biex tibda taqla' kisbiet."
          }
        }
      }
    },
