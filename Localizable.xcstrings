    "Opens your travel dashboard with visited countries, achievements, and continent progress." : {
      "comment" : "Description of the intent to open the travel stats interface.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отваря вашето табло за пътувания с посетени държави, постижения и напредък на континенти."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře váš cestovní přehled s navštívenými zeměmi, úspěchy a pokrokem na kontinentech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner dit rejseoverblik med besøgte lande, præstationer og kontinentfremskridt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet dein Reise-Dashboard mit besuchten Ländern, Erfolgen und Kontinent-Fortschritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει την πίνακα ταξιδίου με τις επισκεφθείσες χώρες, τα επιτεύγματα και την πρόοδο ηπείρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opens your travel dashboard with visited countries, achievements, and continent progress."
          }
        },
