    "Keep everything and add visits that aren't already recorded." : {
      "comment" : "Explains the 'Fill blanks' photo import scan mode",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазване на всичко и добавяне на непосетени посещения."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechat vše a přidat nezaznamenané návštěvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold alt og tilføj ikke-registrerede besøg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles behalten und nicht erfasste Besuche hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατήρηση όλων και προσθήκη μη καταγεγραμμένων επισκέψεων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep everything and add visits that aren't already recorded."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konservi ĉion kaj aldoni ne registritajn vizitojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar todo y añadir visitas no registradas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilita kõik ja lisa salvestamata külastused."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä kaikki ja lisää tallentamattomat käynnit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout conserver et ajouter les visites non enregistrées."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinnigh gach rud agus cuir cuairteanna nár taifeadadh leo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadrži sve i dodaj neevidentirane posjete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindent megtart és hozzáadja a nem rögzített látogatásokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni tutto e aggiungi le visite non registrate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてを保持し、未記録の訪問を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 항목을 유지하고 기록되지 않은 방문을 추가합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išsaugoti viską ir pridėti neįrašytus apsilankymus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saglabāt visu un pievienot neierakstītus apmeklējumus."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żomm kollox u żid żjarat li għadhom ma ġewx irreġistrati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles behouden en niet-geregistreerde bezoeken toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj wszystko i dodaj nieodnotowane wizyty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter tudo e adicionar visitas não registradas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter tudo e adicionar visitas não registadas."
          }
        },
        "ro" : {
