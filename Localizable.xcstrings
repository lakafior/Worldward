    "Tap a country on the Map to mark where you've been.": {
      "comment": "A description of the content of the been list.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na zemi na Mapě a označte, kde jste byli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Land auf der Karte, um zu markieren, wo du warst."
          }
        },
