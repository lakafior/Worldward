    "Mark countries as visited or import from Photos to start earning achievements.": {
      "comment": "A description of the content that is available when the user has not yet traveled.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte země jako navštívené nebo importujte z fotek a začněte získávat úspěchy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Länder als besucht oder importiere aus Fotos, um Erfolge zu sammeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Mark countries as visited or import from Photos to start earning achievements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca países como visitados o importa desde Fotos para comenzar a ganar logros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez des pays comme visités ou importez depuis Photos pour commencer à gagner des succès."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje meg az országokat meglátogatottként vagy importáljon a Fotókból, és kezdje el gyűjteni az eredményeket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna paesi come visitati o importa da Foto per iniziare a guadagnare obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国を訪問済みとしてマークするか、写真からインポートして実績を獲得しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가를 방문한 것으로 표시하거나 사진에서 가져와 성과를 해제해보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz kraje jako odwiedzone lub zaimportuj ze Zdjęć, aby zacząć zdobywać osiągnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque países como visitados ou importe das Fotos para começar a ganhar conquistas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque países como visitados ou importe das Fotos para começar a ganhar conquistas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte krajiny ako navštívené alebo importujte z fotiek a začnite získavať úspechy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将国家标记为已访问，或从照片导入以开始解锁成就。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Marku landojn kiel vizititaj aŭ importu de Fotoj por komenci gajni atingojn."
          }
        }
      }
    },
