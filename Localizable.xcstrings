    "These names didn't match any country and will be skipped." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези имена не съответстват на никоя държава и ще бъдат пропуснати."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato jména neodpovídají žádné zemi a budou přeskočena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse navne matchede ikke noget land og vil blive sprunget over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Namen konnten keinem Land zugeordnet werden und werden übersprungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα ονόματα δεν ταιριάζουν με καμία χώρα και θα παραλειφθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These names didn't match any country and will be skipped."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉi tiuj nomoj ne kongruis kun ajna lando kaj estos preterlasitaj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos nombres no coincidieron con ningún país y se omitirán."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need nimed ei vastanud ühelegi riigile ja jäetakse vahele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä nimet eivät vastanneet yhtään maata ja ne ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces noms ne correspondent à aucun pays et seront ignorés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níor mheaitseáil na hainmneacha seo aon tír agus scipeáilfear iad."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova imena ne odgovaraju nijednoj zemlji i bit će preskočena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a nevek nem feleltek meg egyik országnak sem, és kimaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi nomi non corrispondono a nessun paese e verranno saltati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの名前はいずれの国とも一致せず、スキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이름들은 어떤 국가와도 일치하지 않아 건너뜁니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šie pavadinimai neatitiko jokios šalies ir bus praleisti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šie nosaukumi neatbilda nevienai valstij un tiks izlaisti."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawn l-ismijiet ma qabblu ma' l-ebda pajjiż u se jiġu mqabtżin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze namen kwamen niet overeen met een land en worden overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te nazwy nie pasują do żadnego kraju i zostaną pominięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes nomes não corresponderam a nenhum país e serão ignorados."
