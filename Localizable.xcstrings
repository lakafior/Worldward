            "value": "Toca un país en el Mapa para marcar dónde has estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un pays sur la Carte pour marquer où vous êtes allé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érintsen meg egy országot a térképen, hogy megjelölje, hol járt."
          }
        },
        "it": {
          "stringUnit": {
