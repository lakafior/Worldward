        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bain triail as na tíortha ar thug tú cuairt orthu a ainmniú níos dírí."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipprova semmi l-pajjiżi li żort b'mod aktar dirett."
          }
        }
      }
    },
    "Turn on Apple Intelligence in Settings to ask about your travels.": {
      "comment": "A description of the Apple Intelligence settings.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Apple Intelligence v Nastavení a ptejte se na své cesty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Apple Intelligence in den Einstellungen, um nach deinen Reisen zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Turn on Apple Intelligence in Settings to ask about your travels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Ajustes para preguntar sobre tus viajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans les Réglages pour poser des questions sur vos voyages."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be az Apple Intelligence-t a Beállításokban, hogy az utazásairól kérdezhessen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Impostazioni per chiedere dei tuoi viaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でApple Intelligenceをオンにして、旅行について質問しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Apple Intelligence를 켬고 여행에 대해 묻어보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Apple Intelligence w Ustawieniach, aby pytać o swoje podróże."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Apple Intelligence nos Ajustes para perguntar sobre suas viagens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Apple Intelligence nos Ajustes para perguntar sobre suas viagens."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Apple Intelligence v Nastaveniach a pýtajte sa na svoje cesty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中打开 Apple Intelligence 来咨询您的旅行。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ŝaltu Apple Intelligence en Agordoj por demandi pri viaj vojaĝoj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Apple Intelligence til i Indstillinger for at spørge om dine rejser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence i Inställningar för att fråga om dina resor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Apple Intelligence käyttöön Asetuksissa kysyäksesi matkoistasi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Apple Intelligence sisse Seadetes, et küsida oma reiside kohta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Apple Intelligence in in Instellingen om naar je reizen te vragen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете Apple Intelligence в Настройките, за да питате за пътуванията си."
          }
        },
        "hr": {
