    "Columns were detected automatically — adjust them if the preview looks wrong. Only the country column is required." : {
      "comment" : "Footer for the columns section of the CSV import view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колоните бяха открити автоматично — коригирайте ги, ако прегледът изглежда грешен. Изисква се само колоната за държава."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sloupce byly detekovány automaticky — upravte je, pokud náhled vypadá špatně. Je vyžadován pouze sloupec země."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolonner blev registreret automatisk — juster dem, hvis forhåndsvisningen ser forkert ud. Kun landekolonnen er påkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalten wurden automatisch erkannt — passe sie an, falls die Vorschau falsch aussieht. Nur die Länderspalte ist erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι στήλες εντοπίστηκαν αυτόματα — προσαρμόστε τις αν η προεπισκόπηση φαίνεται λάθος. Απαιτείται μόνο η στήλη χώρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Columns were detected automatically — adjust them if the preview looks wrong. Only the country column is required."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolonoj estis aŭtomate detektitaj — alĝustigu ilin se la antaŭvido aspektas malĝuste. Nur la landa kolono estas postulata."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las columnas se detectaron automáticamente — ajústalas si la vista previa no se ve bien. Solo se requiere la columna de país."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veerud tuvastati automaatselt — kohanda neid, kui eelvaade tundub vale. Ainult riigi veerg on nõutav."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarakkeet tunnistettiin automaattisesti — säädä niitä, jos esikatselu näyttää väärältä. Vain maa-sarake on pakollinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les colonnes ont été détectées automatiquement — ajustez-les si l'aperçu semble incorrect. Seule la colonne pays est requise."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braithadh na colúin go huathoibríoch — coigeartaigh iad má tá an réamhamharc mícheart. Ní theastaíonn ach an colún tíre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stupci su automatski otkriveni — prilagodite ih ako pregled izgleda pogrešno. Potreban je samo stupac za zemlju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az oszlopok automatikusan érzékelésre kerültek — állítsd be őket, ha az előnézet hibás. Csak az ország oszlop kötelező."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le colonne sono state rilevate automaticamente — regolale se l'anteprima non sembra corretta. È richiesta solo la colonna del paese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列は自動検出されました — プレビューが正しくない場合は調整してください。国列のみ必須です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열이 자동으로 감지되었습니다 — 미리보기가 올바르지 않으면 조정하세요. 국가 열만 필수입니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stulpeliai buvo aptikti automatiškai — pakoreguokite juos, jei peržiūra atrodo neteisinga. Būtinas tik šalies stulpelis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolonnas tika noteiktas automātiski — pielāgojiet tās, ja priekšskatījums izskatās nepareizs. Tikai valsts kolonna ir obligāta."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-kolonni nstabu awtomatikament — aġġustahom jekk il-preview tidher ħażina. Hija meħtieġa biss il-kolonna tal-pajjiż."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolommen zijn automatisch gedetecteerd — pas ze aan als de voorvertoning er niet goed uitziet. Alleen de landkolom is vereist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolumny zostały wykryte automatycznie — dostosuj je, jeśli podgląd wygląda źle. Wymagana jest tylko kolumna kraju."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As colunas foram detectadas automaticamente — ajuste-as se a prévia parecer errada. Apenas a coluna de país é obrigatória."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As colunas foram detetadas automaticamente — ajuste-as se a pré-visualização parecer errada. Apenas a coluna de país é obrigatória."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloanele au fost detectate automat — ajustați-le dacă previzualizarea pare greșită. Doar coloana cu țara este obligatorie."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stĺpce boli detegované automaticky — upravte ich, ak sa náhľad zdá nesprávny. Vyžaduje sa iba stĺpec krajiny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stolpci so bili samodejno zaznani — prilagodite jih, če je predogled napačen. Zahtevan je le stolpec za državo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolumner upptäcktes automatiskt — justera dem om förhandsvisningen ser fel ut. Endast landskolumnen är obligatorisk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列已自动检测 — 如果预览不正确，请调整。只有国家列是必填项。"
          }
        }
      }
    },
