    "Records a visit to a country, optionally on a specific date." : {
      "comment" : "Description of the Log Visit intent.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
