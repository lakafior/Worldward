    "Sets a country's travel status — visited, lived, crossed, or living.": {
      "comment": "Description of the intent that sets a country's travel status.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví stav cesty pro zemi — navštíveno, žil(a), projíždělo nebo žijící."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt den Reisestatus eines Landes fest – besucht, gelebt, durchreist oder lebend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sets a country's travel status — visited, lived, crossed, or living."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el estado de viaje de un país — visitado, vivido, cruzado o viviendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le statut de voyage d’un pays — visité, vécu, traversé ou vit actuellement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja egy ország utazási állapotát — meglátogatva, ott élt, átutazva, vagy ott él."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta lo stato di viaggio di un paese — visitato, vissuto, attraversato o ci vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国の旅行ステータスを「訪問済み」「住んだ」「通過」「住んでいる」のいずれかに設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국가의 여행 상태를 설정합니다 — 방문, 살아본, 경과, 현재 거주."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia status podróży kraju — odwiedzony, mieszkałem, przekroczony lub mieszkam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o status de viagem de um país — visitado, morei, atravessado ou moro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o status de viagem de um país — visitado, morei, atravessado ou moro."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví stav cesty pre krajinu — navštívené, žil(a), prejdené alebo žijúci."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置国家的旅行状态——已访问、居住过、经过或正在居住。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Agordas landan vojaĝan staton — vizitita, loĝis, trapasita aŭ loĝanta."
          }
        }
      }
    },
    "Sets your most-present country to “Living”. An existing home is never overwritten.": {
      "comment": "A description of the home country setting.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví zemi, kde trávíte nejvíce času, jako „žijící“. Stávající domov není nikdy přepsán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt dein am häufigsten anwesendes Land auf „Lebend\". Ein bestehendes Zuhause wird nie überschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sets your most-present country to “Living”. An existing home is never overwritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece tu país más presente como «Viviendo». Un hogar existente nunca se sobrescribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit votre pays le plus présent comme « Vit actuellement ». Un domicile existant n’est jamais écrasé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja a legtöbb időt eltöltött országot „Ott él” állapotra. Meglévő otthon soha nem kerül felülírásra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il tuo paese più presente come «Ci vivo». Una casa esistente non viene mai sovrascritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も幅広く居た国を「住んでいる」に設定します。既存のホームは上書きされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 오래 머물러있는 국가를 “살고 있는”으로 설정합니다. 기존 홈은 겹쳐쓰지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia Twój najczęściej obecny kraj jako „Mieszkam”. Istniejący dom nigdy nie jest nadpisywany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define seu país mais frequente como «Moro». Um lar existente nunca é sobrescrito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define seu país mais frequente como «Moro». Um lar existente nunca é sobrescrito."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví krajinu, kde trávite najviac času, ako „žijúci“. Existujúci domov nie je nikdy prepísaný."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您居住时间最长的国家设为“正在居住”。已有的家乡不会被覆盖。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Agordas vian plej čeestatan landon kiel “Loĝanta”. Ekzistanta hejmo neniam estas anstataŭigita."
          }
        }
      }
    },
