    "Ask me anything about the countries you've visited — on-device, private to you.": {
      "comment": "A description of the functionality of the Travel Chat view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se na cokoli o zemích, které jste navštívili — zpracováno na zařízení, soukromé jen pro vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mich alles zu den Ländern, die du besucht hast – auf dem Gerät, privat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Ask me anything about the countries you've visited — on-device, private to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntame lo que quieras sobre los países que has visitado — en el dispositivo, privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-moi tout sur les pays que vous avez visités — sur l’appareil, en toute confidentialité."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezzen bármit a meglátogatott országokról — az eszközén történik, csak Ön látja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedimi tutto sui paesi che hai visitato — sul dispositivo, privato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪れた国について何でも質問してください — デバイス上で処理され、あなただけにプライベートです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문한 국가에 관해 무엇이나 묻어보세요 — 기기 내에서 처리되며, 당신만의 개인정보로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj o wszystko dotyczące krajów, które odwiedziłeś — na urządzeniu, prywatnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-me qualquer coisa sobre os países que você visitou — no dispositivo, privado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-me qualquer coisa sobre os países que você visitou — no dispositivo, privado."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spýtajte sa na čokoľvek o krajinách, ktoré ste navštívili — spracované na zariadení, súkromné len pre vás."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽管问我您去过的国家——在设备上处理，仅属于您个人隐私。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandu min ion ajn pri la landoj kiujn vi vizitis — sur aparato, private nur por vi."
          }
        }
      }
    },
