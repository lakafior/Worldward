    "Tap a country on the Map to mark where you've been.": {
      "comment": "A description of the content of the been list.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na zemi na Mapě a označte, kde jste byli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Land auf der Karte, um zu markieren, wo du warst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Tap a country on the Map to mark where you've been."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un país en el Mapa para marcar dónde has estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un pays sur la Carte pour marquer où vous êtes allé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érintsen meg egy országot a térképen, hogy megjelölje, hol járt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un paese sulla Mappa per segnare dove sei stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップ上の国をタップして、訪れた場所をマークしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도에서 국가를 탭하여 가본 곳을 표시하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij kraju na Mapie, aby oznaczyć, gdzie byłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um país no Mapa para marcar onde você esteve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um país no Mapa para marcar onde você esteve."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na krajinu na Mape a označte, kde ste boli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击地图上的国家来标记您去过的地方。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Frapetu landon sur la Mapo por marki kie vi estis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et land på kortet for at markere hvor du har været."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett land på kartan för att markera var du har varit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta maata kartalla merkitäksesi missä olet käynyt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta riiki kaardil, et märkida kus oled käinud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een land op de kaart om te markeren waar je bent geweest."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете се до държава на Картата, за да отбележите където сте били."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite državu na Karti da označite gdje ste bili."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε μια χώρα στον Χάρτη για να σημειώσετε πού έχετε πάει."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți o țară pe Hartă pentru a marca unde ați fost."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotaknite se države na Zemljevidu, da označite kje ste bili."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties valstij kartē, lai atzīmētu, kur esat bijis."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite šalį žemėlapyje, kad pažymėtumėte, kur buvote."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil tír ar an Léarscáil chun an áit a raibh tú a mharcáil."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tektek pajjiż fuq il-Mappa biex timmarka fejn kont."
          }
        }
      }
