    "No photos with location data matched a country, or everything is already imported." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никои снимки с данни за местоположение не съвпаднаха с държава или всичко вече е внесено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné fotky s údaji o poloze neodpovídají zemi, nebo je vše již importováno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen billeder med lokalitetsdata matchede et land, eller alt er allerede importeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Fotos mit Standortdaten konnten einem Land zugeordnet werden, oder alles wurde bereits importiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία φωτογραφία με δεδομένα τοποθεσίας δεν αντιστοιχεί σε χώρα ή όλα έχουν ήδη εισαχθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No photos with location data matched a country, or everything is already imported."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neniuj fotoj kun lokaj datumoj kongruis kun lando, aŭ ĉio jam estas importita."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna foto con datos de ubicación coincidió con un país, o todo ya está importado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ükski asukohaandmetega foto ei vastanud riigile või on kõik juba imporditud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksikään kuva sijaintitiedoilla ei vastannut maata, tai kaikki on jo tuotu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune photo avec des données de localisation ne correspond à un pays, ou tout est déjà importé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níor mheaitseáil aon ghrianghraf le sonraí suímh le tír, nó tá gach rud iompórtáilte cheana."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedna fotografija s podacima o lokaciji ne odgovara državi ili je sve već uvezeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyetlen helyadatokat tartalmazó fotó sem feleltethető meg országnak, vagy minden már importálva van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
