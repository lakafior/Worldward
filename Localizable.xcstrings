    "Returns how many countries you've visited, along with a per‑status breakdown." : {
      "comment" : "Description of the Get Visit Count intent.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възвраща броя на посетените от вас държави, заедно с разбивка по състояние."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrátí počet navštívených zemí a rozpis podle stavu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returnerer hvor mange lande du har besøgt, sammen med en opdeling efter status."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt zurück, wie viele Länder du besucht hast, zusammen mit einer Aufschlüsselung nach Status."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιστρέφει πόσες χώρες έχετε επισκεφτεί, μαζί με ανάλυση ανά κατάσταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Returns how many countries you've visited, along with a per‑status breakdown."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveras kiom da landoj vi vizitis, kune kun rompo laŭ stato."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve cuántos países has visitado, junto con un desglose por estado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagastab mitu riiki oled külastanud koos jaotusega staatuste kaupa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauttaa kuinka monessa maassa olet käynyt sekä erittelyn tiloittain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retourne combien de pays vous avez visités, avec une ventilation par statut."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filleann sé cé mhéad tír ar thug tú cuairt orthu, mar aon le miondealú in aghaidh stádais."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraća koliko ste država posjetili, zajedno s raščlanbom po statusu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszaadja a meglátogatott országok számát, állapot szerinti bontásban."
          }
        },
        "it" : {
