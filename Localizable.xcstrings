    "Detects your current country and marks it with the chosen travel status.": {
      "comment": "Description of the intent that marks the user's current location as visited.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpozná vaši aktuální zemi a označí ji zvoleným stavem cesty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt dein aktuelles Land und markiert es mit dem gewählten Reisestatus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Detects your current country and marks it with the chosen travel status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta tu país actual y lo marca con el estado de viaje elegido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte votre pays actuel et le marque avec le statut de voyage choisi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érzékeli a jelenlegi országot és a kiválasztott utazási állapottal jelöli meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileva il tuo paese attuale e lo contrassegna con lo stato di viaggio scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の国を検出し、選択した旅行ステータスでマークします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 국가를 감지하고 선택한 여행 상태로 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykrywa Twój obecny kraj i oznacza go wybranym statusem podróży."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta seu país atual e o marca com o status de viagem escolhido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta seu país atual e o marca com o status de viagem escolhido."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpozná vašu aktuálnu krajinu a označí ju zvoleným stavom cesty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测您当前的国家并以选定的旅行状态标记它。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Detektas vian nunan landon kaj markas ĝin per la elektita vojaĝa stato."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer dit nuværende land og markerer det med den valgte rejsestatus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upptäcker ditt nuvarande land och markerar det med vald resestatus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistaa nykyisen maasi ja merkitsee sen valitulla matkastatuksella."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuvastab sinu praeguse riigi ja märgib selle valitud reisistaatusega."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecteert je huidige land en markeert het met de gekozen reisstatus."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Открива текущата ви държава и я маркира с избрания пътнишески статус."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkriva vašu trenutnu državu i označava je odabranim statusom putovanja."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανιχνεύει την τρέχουσα χώρα σας και την σημειώνει με την επιλεγμένη κατάσταση ταξιδίου."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectează țara curentă și o marchează cu statusul de călătorie ales."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazna vašo trenutno državo in jo označi z izbranim statusom potovanja."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosaka jūsu pašreizējo valsti un atzīmē to ar izvēlēto ceļojuma statusu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptinka jūsų dabartinę šalį ir pažymi ją pasirinktu kelionės statusu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Braitheann sé do thír reatha agus marcáiltear í leis an stádas taistil roghnaithe."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiskopri l-pajjiż kurrenti tiegħek u jimmarkah bl-istatus tal-ivvjaġġar magħżul."
          }
        }
      }
    },
