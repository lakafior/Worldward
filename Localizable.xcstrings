    "Find a country on the Map and add it to your wishlist." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намерете държава на Картата и я добавете в списъка си за желания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najděte zemi na Mapě a přidejte ji do svého seznamu přání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find et land på kortet og føj det til din ønskeliste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde ein Land auf der Karte und füge es deiner Wunschliste hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρείτε μια χώρα στον Χάρτη και προσθέστε την στη λίστα επιθυμιών σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Find a country on the Map and add it to your wishlist."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trovu landon sur la Mapo kaj aldonu ĝin al via dezirolisto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra un país en el Mapa y añádelo a tu lista de deseos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otsi riik kaardil ja lisa see oma soovinimekirja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi maa kartalta ja lisää se toivelistaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez un pays sur la Carte et ajoutez-le à votre liste de souhaits."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aimsigh tír ar an Léarscáil agus cuir le do liosta mianta í."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronađite državu na Karti i dodajte je na svoj popis želja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keressen egy országot a Térképen, és adja hozzá a kívánságlistájához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova un paese sulla Mappa e aggiungilo alla tua lista dei desideri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップで国を見つけてウィッシュリストに追加しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서 국가를 찾아 위시리스트에 추가하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raskite šalį žemėlapyje ir pridėkite ją prie norų sąrašo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
