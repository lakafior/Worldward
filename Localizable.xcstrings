            "value": "Încercați să numiți țările pe care le-ați vizitat mai direct."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskusite bolj neposredno poimenovati države, ki ste jih obiskali."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mēģiniet nosaukt valstis, kuras apmeklējāt, tiešāk."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pabandykite įvardinti šalis, kurias aplankėte, tiesiogiai."
