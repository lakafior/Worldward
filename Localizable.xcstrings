    "Sets a country's travel status — visited, lived, crossed, or living." : {
      "comment" : "Description of the intent that sets a country's travel status.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задава пътнишеския статус на държава — посетено, пребивавал(a), преминато или пребиваващ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví stav cesty pro zemi — navštíveno, žil(a), projíždělo nebo žijící."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstiller et lands rejsestatus — besøgt, boet, gennemrejst eller boende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt den Reisestatus eines Landes fest – besucht, gelebt, durchreist oder lebend."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίζει την κατάσταση ταξιδίου μιας χώρας — επισκεφθείσα, έζησε, διασχίστηκε ή ζεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sets a country's travel status — visited, lived, crossed, or living."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agordas landan vojaĝan staton — vizitita, loĝis, trapasita aŭ loĝanta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece el estado de viaje de un país — visitado, vivido, cruzado o viviendo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määrab riigi reisistaatuse — külastatud, elatud, läbitud või elab."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa maan matkastatuksen — vierailtu, asuttu, läpikuljettu tai asuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit le statut de voyage d’un pays — visité, vécu, traversé ou vit actuellement."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Socraíonn sé stádas taistil tíre — thug cuairt, chónaigh, trasnaithe, nó ag maireachtáil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavlja status putovanja države — posjećeno, živio/la, pređeno ili živi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítja egy ország utazási állapotát — meglátogatva, ott élt, átutazva, vagy ott él."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta lo stato di viaggio di un paese — visitato, vissuto, attraversato o ci vivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国の旅行ステータスを「訪問済み」「住んだ」「通過」「住んでいる」のいずれかに設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가의 여행 상태를 설정합니다 — 방문, 살아본, 경과, 현재 거주."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustato šalies kelionės statusą — aplankyta, gyveno, kertama ar gyvenantis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iestata valsts ceļojuma statusu — apmeklēts, dzīvojis, šķērsots vai dzīvojošs."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jissettja l-istatus tal-ivvjaġġar ta' pajjiż — żurat, għex, maqsum, jew jgħix."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt de reisstatus van een land in — bezocht, gewoond, doorgereisd of wonend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia status podróży kraju — odwiedzony, mieszkałem, przekroczony lub mieszkam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o status de viagem de um país — visitado, morei, atravessado ou moro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o status de viagem de um país — visitado, morei, atravessado ou moro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează statusul de călătorie al unei țări — vizitat, trăit, tranzitat sau trăiește."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví stav cesty pre krajinu — navštívené, žil(a), prejdené alebo žijúci."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavi status potovanja države — obiskano, živel/živela, prečrtano ali živeč."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställer in ett lands resestatus — besökt, bodde, genomrest eller bor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置国家的旅行状态——已访问、居住过、经过或正在居住。"
          }
        }
      }
    },
    "Sets your most-present country to “Living”. An existing home is never overwritten." : {
      "comment" : "A description of the home country setting.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задава най-присъстващата ви държава като “Пребиваващ”. Съществуващ дом никога не се презаписва."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví zemi, kde trávíte nejvíce času, jako „žijící“. Stávající domov není nikdy přepsán."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstiller dit mest tilstedeværende land til “Boende”. Et eksisterende hjem bliver aldrig overskrevet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt dein am häufigsten anwesendes Land auf „Lebend\". Ein bestehendes Zuhause wird nie überschrieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίζει την πιο παρούσα χώρα σας σε «Ζεί». Ένα υπάρχον σπίτι δεν αντικαθίσταται ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sets your most-present country to “Living”. An existing home is never overwritten."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agordas vian plej čeestatan landon kiel “Loĝanta”. Ekzistanta hejmo neniam estas anstataŭigita."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece tu país más presente como «Viviendo». Un hogar existente nunca se sobrescribe."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määrab sinu kõige rohkem kohaloleva riigi “Elab” olekusse. Olemasolevat kodu ei kirjutata kunagi üle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa eniten läsnäolevan maasi tilaan “Asuu”. Olemassa olevaa kotia ei koskaan korvata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit votre pays le plus présent comme « Vit actuellement ». Un domicile existant n’est jamais écrasé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Socraíonn sé do thír is láithreacht mar “Ag Maireachtáil”. Ní scríobhtar thar bhaile atá ann cheana go brách."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavlja vašu najprisutniju državu na “Živi”. Postojeći dom se nikada ne prebriše."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítja a legtöbb időt eltöltött országot „Ott él” állapotra. Meglévő otthon soha nem kerül felülírásra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta il tuo paese più presente come «Ci vivo». Una casa esistente non viene mai sovrascritta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も幅広く居た国を「住んでいる」に設定します。既存のホームは上書きされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 오래 머물러있는 국가를 “살고 있는”으로 설정합니다. 기존 홈은 겹쳐쓰지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustato jūsų labiausiai lankomą šalį kaip “Gyvenantis”. Esami namai niekada neperrašomi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iestata jūsu visbiežāk pārstāvēto valsti kā “Dzīvojošs”. Esošā mājas valsts nekad netiek pārrakstīta."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jissettja l-aktar pajjiż preżenti tiegħek bħala “Jgħix”. Dar eżistenti qatt ma tinkiteb fuqha."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt je meest aanwezige land in op “Wonend”. Een bestaand thuis wordt nooit overschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia Twój najczęściej obecny kraj jako „Mieszkam”. Istniejący dom nigdy nie jest nadpisywany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define seu país mais frequente como «Moro». Um lar existente nunca é sobrescrito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define seu país mais frequente como «Moro». Um lar existente nunca é sobrescrito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează cea mai prezentă țară la “Trăiește”. Un cămin existent nu este niciodată suprascris."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví krajinu, kde trávite najviac času, ako „žijúci“. Existujúci domov nie je nikdy prepísaný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavi vašo najbolj prisotno državo na “Živeč”. Obstoječ dom se nikoli ne prepiše."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställer in ditt mest närvarande land till “Bor”. Ett befintligt hem skrivs aldrig över."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将您居住时间最长的国家设为“正在居住”。已有的家乡不会被覆盖。"
          }
        }
      }
    },
