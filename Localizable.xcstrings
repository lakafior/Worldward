    "Mark countries as visited or import from Photos to start earning achievements." : {
      "comment" : "A description of the content that is available when the user has not yet traveled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маркирайте държави като посетени или внесете от снимки, за да започнете да печелите постижения."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označte země jako navštívené nebo importujte z fotek a začněte získávat úspěchy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markér lande som besøgt eller importer fra billeder for at begynde at optjene præstationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Länder als besucht oder importiere aus Fotos, um Erfolge zu sammeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημειώστε χώρες ως επισκεφθείσες ή εισάγετε από Φωτογραφίες για να αρχίσετε να κερδίζετε επιτεύγματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mark countries as visited or import from Photos to start earning achievements."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marku landojn kiel vizititaj aŭ importu de Fotoj por komenci gajni atingojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca países como visitados o importa desde Fotos para comenzar a ganar logros."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märgi riigid külastatuks või impordi fotodest, et hakata saavutusi koguma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkitse maita vierailluiksi tai tuo kuvista aloittaaksesi saavutusten ansaitsemisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez des pays comme visités ou importez depuis Photos pour commencer à gagner des succès."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcáil tíortha mar thug tú cuairt orthu nó iompórtáil ó Ghrianghraif chun tús a bhaint le éachtaí a thuilleamh."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označite države kao posjećene ili uvezite iz fotografija kako biste poČeli zarađivati postignuća."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelölje meg az országokat meglátogatottként vagy importáljon a Fotókból, és kezdje el gyűjteni az eredményeket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna paesi come visitati o importa da Foto per iniziare a guadagnare obiettivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
