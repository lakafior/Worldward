            "state": "translated",
            "value": "Yksikään kuva sijaintitiedoilla ei vastannut maata, tai kaikki on jo tuotu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükski asukohaandmetega foto ei vastanud riigile või on kõik juba imporditud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen foto's met locatiegegevens kwamen overeen met een land, of alles is al geïmporteerd."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никои снимки с данни за местоположение не съвпаднаха с държава или всичко вече е внесено."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedna fotografija s podacima o lokaciji ne odgovara državi ili je sve već uvezeno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία φωτογραφία με δεδομένα τοποθεσίας δεν αντιστοιχεί σε χώρα ή όλα έχουν ήδη εισαχθεί."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio fotografie cu date de locație nu s-a potrivit cu o țară sau totul este deja importat."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobena fotografija s podatki o lokaciji se ne ujema z državo ali pa je vse že uvoženo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neviena foto ar atrašanās vietas datiem nesakrita ar valsti, vai arī viss jau ir importēts."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nė viena nuotrauka su vietos duomenimis nesutapo su šalimi, arba viskas jau importuota."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor mheaitseáil aon ghrianghraf le sonraí suímh le tír, nó tá gach rud iompórtáilte cheana."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ebda ritratt b'dejta tal-lokazzjoni ma qabel ma' pajjiż, jew kollox diġà importat."
          }
        }
      }
    },
