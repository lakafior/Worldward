          "stringUnit" : {
            "state" : "translated",
            "value" : "La sur-aparata modelo ankoraŭ elŝutiĝas. Provu denove post iom da tempo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo en el dispositivo aún se está descargando. Inténtalo de nuevo en un momento."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seadmesisene mudel alles laadib. Proovi uuesti natuke aja pärast."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteen malli latautuu vielä. Yritä uudelleen hetken kuluttua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle sur l’appareil est encore en téléchargement. Réessayez dans un instant."
