        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisera med iCloud"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 iCloud 同步"
          }
        }
      }
    },
    "Tailors the on-device trip assistant. “Pack for” decides whether the packing list includes gender-specific items, preferences are extra packing notes it factors in, and interests steer the sightseeing suggestions." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Персонализира локалния асистент за пътувания. „Опаковай за“ решава дали списъкът за опаковане включва артикули, свързани с пола, предпочитанията са допълнителни бележки за опаковане, които той взема предвид, а интересите насочват предложенията за разглеждане."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobuje místního cestovního asistenta. „Zabalit pro“ rozhoduje, zda balicí seznam zahrnuje položky specifické pro pohlaví, předvolby jsou další poznámky k balení, které zohledňuje, a zájmy usměrňují návrhy, co navštívit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpasser den lokale rejseassistent. „Pak til“ bestemmer, om pakkelisten inkluderer kønsspecifikke genstande, præferencer er ekstra pakkenoter, den tager i betragtning, og interesser styrer seværdighedsforslagene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt den lokalen Reiseassistenten an. „Packen für“ entscheidet, ob die Packliste geschlechtsspezifische Artikel enthält, Einstellungen sind zusätzliche Packhinweise, die berücksichtigt werden, und Interessen steuern die Sightseeing-Vorschläge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόζει τον τοπικό βοηθό ταξιδιού. Το „Συσκευασία για“ αποφασίζει εάν η λίστα συσκευασίας περιλαμβάνει είδη συγκεκριμένου φύλου, οι προτιμήσεις είναι επιπλέον σημειώσεις συσκευασίας που λαμβάνει υπόψη και τα ενδιαφέροντα κατευθύνουν τις προτάσεις αξιοθέατων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailors the on-device trip assistant. “Pack for” decides whether the packing list includes gender-specific items, preferences are extra packing notes it factors in, and interests steer the sightseeing suggestions."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alĝustigas la lokan vojaĝasistanton. „Paki por“ decidas ĉu la paklisto inkluzivas seks-specifajn erojn, agordoj estas kromaj paknotoj, kiujn ĝi konsideras, kaj interesoj gvidas la vidindaĵajn sugestojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapta el asistente de viaje local. „Empacar para“ decide si la lista de equipaje incluye artículos específicos de género, las preferencias son notas adicionales de equipaje que tiene en cuenta y los intereses orientan las sugerencias de lugares para visitar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohandab kohalikku reisiabilist. „Paki jaoks“ otsustab, kas pakkimisnimekiri hõlmab soospetsiifilisi esemeid, eelistused on lisamärkmed pakkimise kohta, mida see arvesse võtab, ja huvid suunavad vaatamisväärsuste soovitusi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukauttaa laitteen matka-avustajan. „Pakkaa kohteelle“ päättää, sisältääkö pakkauslista sukupuolikohtaisia tuotteita, asetukset ovat lisähuomautuksia pakkaamiseen, jotka se ottaa huomioon, ja kiinnostuksen kohteet ohjaavat nähtävyysehdotuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapte l'assistant de voyage local. „Préparer pour“ décide si la liste de bagages inclut des articles spécifiques au genre, les préférences sont des notes supplémentaires qu'il prend en compte, et les centres d'intérêt orientent les suggestions de visites."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saincheapann sé an cúntóir taistil ar an ngléas. Cinnfidh „Pacáil do“ an gcuimsíonn an liosta pacála míreanna atá sonrach don inscne, is nótaí pacála breise iad sainroghanna a chuireann sé san áireamh, agus treoraíonn na suimeanna na moltaí turasóireachta."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagođava lokalnog putnog asistenta. „Spakiraj za“ odlučuje uključuje li popis za pakiranje predmete specifične za spol, postavke su dodatne napomene za pakiranje koje uzima u obzir, a interesi usmjeravaju prijedloge znamenitosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testreszabja az eszközön lévő utazási asszisztenst. A „Csomagolás ehhez:“ dönti el, hogy a csomagolási lista tartalmaz-e nem-specifikus elemeket, a beállítások további csomagolási megjegyzések, amelyeket figyelembe vesz, az érdeklődési körök pedig a látnivaló-javaslatokat irányítják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizza l'assistente di viaggio locale. „Prepara per“ decide se la lista dei bagagli include articoli specifici per genere, le preferenze sono note extra che prende in considerazione e gli interessi orientano i suggerimenti sulle attrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンデバイスの旅行アシスタントを調整します。「荷造り」はパッキングリストに性別固有のアイテムを含めるかどうかを決定し、設定は考慮される追加のメモ、興味は観光の提案に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 내 여행 도우미를 조정합니다. „준비물“은 짐 목록에 성별별 항목을 포함할지 여부를 결정하고, 환경설정은 참고하는 추가 메모이며, 관심사는 관광 제안에 반영됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritaiko vietinį kelionių asistentą. „Pakuoti“ nusprendžia, ar pakavimo sąraše bus pagal lytį specifinių daiktų, nuostatos yra papildomos pakavimo pastabos, į kurias atsižvelgiama, o pomėgiai nukreipia lankytinų vietų pasiūlymus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pielāgo vietējo ceļojumu asistentu. „Sapakot“ izlemj, vai iepakošanas sarakstā iekļaut dzimumam specifiskus priekšmetus, iestatījumi ir papildu piezīmes par iepakošanu, ko tas ņem vērā, un intereses virza apskates vietu ieteikumus."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jippersonalizza l-assistent tal-ivvjaġġar fuq it-tagħmir. „Ippakkja għal“ jiddeċiedi jekk il-lista tal-ippakkjar tinkludix oġġetti speċifiċi għall-ġeneru, il-preferenzi huma noti addizzjonali tal-ippakkjar li jqis, u l-interessi jiggwidaw is-suġġerimenti turistiċi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past de lokale reisassistent aan. „Inpakken voor“ bepaalt of de paklijst gender-specifieke items bevat, voorkeuren zijn extra inpaknotities waarmee rekening wordt gehouden, en interesses sturen de suggesties voor bezienswaardigheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosowuje lokalnego asystenta podróży. „Pakuj dla” decyduje, czy lista pakowania uwzględnia pozycje zależne od płci, preferencje to dodatkowe uwagi do pakowania, które bierze pod uwagę, a zainteresowania ukierunkowują propozycje zwiedzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza o assistente de viagem local. „Fazer mala para“ decide se a lista de bagagem inclui itens específicos de gênero, as preferências são notas extras que ele leva em consideração e os interesses orientam as sugestões de passeios."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza o assistente de viagem local. „Fazer mala para“ decide se a lista de bagagem inclui itens específicos de género, as preferências são notas extras que considera e os interesses orientam as sugestões de visitas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizează asistentul local de călătorie. „Pregătește pentru“ decide dacă lista de bagaje include articole specifice genului, preferințele sunt note suplimentare de bagaj pe care le ia în considerare, iar interesele ghidează sugestiile de obiective turistice."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prispôsobuje miestneho cestovného asistenta. „Zbaliť pre“ rozhoduje, či zoznam na balenie zahŕňa položky špecifické pre pohlavie, nastavenia sú ďalšie poznámky k baleniu, ktoré zohľadňuje, a záujmy usmerňujú návrhy, čo navštíviť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodi lokalnega potovalnega pomočnika. „Spakiraj za“ odloča, ali seznam za pakiranje vključuje predmete, specifične za spol, nastavitve so dodatne opombe za pakiranje, ki jih upošteva, interesi pa usmerjajo predloge znamenitosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassar den lokala reseassistenten. „Packa för“ avgör om packlistan inkluderar könsspecifika artiklar, inställningar är extra packanteckningar som den tar hänsyn till, och intressen styr sevärdhetsförslagen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定制设备上的旅行助手。„打包“决定打包清单是否包括特定性别的物品，偏好设置是其考虑的其他备注，兴趣则引导观光建议。"
          }
        }
      }
    },
