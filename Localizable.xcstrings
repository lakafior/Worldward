    "Allow full Calendar access for Worldward in Settings → Privacy & Security → Calendars, then turn sync on again." : {
      "comment" : "A message that appears when the user denies access to",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете пълен достъп до Календар за Worldward в Настройки → Поверителност и сигурност → Календари, след което включете отново синхронизирането."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte Worldward úplný přístup ke Kalendáři v Nastavení → Soukromí a zabezpečení → Kalendáře a poté znovu zapněte synchronizaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad fuld Kalenderadgang for Worldward i Indstillinger → Privatliv og sikkerhed → Kalendere og slå derefter synkronisering til igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewähren Sie Worldward vollen Kalenderzugriff in Einstellungen → Datenschutz & Sicherheit → Kalender und schalten Sie die Synchronisierung dann wieder ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε πλήρη πρόσβαση στο Ημερολόγιο για το Worldward στις Ρυθμίσεις → Απόρρητο και ασφάλεια → Ημερολόγια και, στη συνέχεια, ενεργοποιήστε ξανά τον συγχρονισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow full Calendar access for Worldward in Settings → Privacy & Security → Calendars, then turn sync on again."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permesu plenan Kalendaran aliron por Worldward en Agordoj → Privateco kaj Sekureco → Kalendaroj, poste reŝaltu la sinkronigon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso completo al Calendario para Worldward en Ajustes → Privacidad y Seguridad → Calendarios, luego vuelve a activar la sincronización."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luba Worldwardile täielik kalendri juurdepääs seadetes Seaded → Privaatsus ja turvalisus → Kalendrid ja lülita seejärel sünkroonimine uuesti sisse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli Worldwardille täysi kalenteripääsy Asetukset → Yksityisyys ja suojaus → Kalenterit ja ota sitten synkronointi uudelleen käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès complet au calendrier pour Worldward dans Réglages → Confidentialité et sécurité → Calendriers, puis réactivez la synchronisation."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceadaigh rochtain iomlán ar Fhéilire do Worldward i Socruithe → Príobháideachas & Slándáil → Féilirí, ansin cas ar shioncronú arís."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućite Worldwardu potpuni pristup Kalendaru u Postavke → Privatnost i sigurnost → Kalendari, zatim ponovno uključite sinkronizaciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezze a teljes Naptár hozzáférést a Worldward számára a Beállítások → Adatvédelem és biztonság → Naptárak menüben, majd kapcsolja be újra a szinkronizálást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso completo al Calendario per Worldward in Impostazioni → Privacy e Sicurezza → Calendari, quindi riattiva la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → プライバシーとセキュリティ → カレンダーでWorldwardのカレンダーへの完全アクセスを許可し、その後同期を再びオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 개인정보 보호 및 보안 → 캘린더서 Worldward에 대한 완전한 캘린더 액세스를 허용한 다음, 동기화를 다시 켜세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiskite pilną Kalendoriaus prieigą Worldward programoje Nustatymai → Privatumas ir saugumas → Kalendoriai, tada vėl įjunkite sinchronizavimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atļojiet pilnu Kalendāra piekļuvi Worldward programmā Iestatījumi → Privātums un drošība → Kalendāri un pēc tam atkal ieslēdziet sinhronizāciju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ħalli aċċess sħiħ għall-Kalendarju għal Worldward f'Settings → Privatezza u Sigurtà → Kalendarji, imbagħad erġa’ ixgħel is-sinkronizzazzjoni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta volledige Agenda-toegang toe voor Worldward in Instellingen → Privacy & Beveiliging → Agenda’s en schakel synchronisatie dan weer in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól Worldward na pełny dostęp do Kalendarza w Ustawieniach → Prywatność i bezpieczeństwo → Kalendarze, a następnie włącz ponownie synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso total ao Calendário para o Worldward em Ajustes → Privacidade e Segurança → Calendários e reative a sincronização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso total ao Calendário para o Worldward em Definições → Privacidade e Segurança → Calendários e reative a sincronização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți accesul complet la Calendar pentru Worldward în Setări → Confidențialitate și securitate → Calendare, apoi reactivați sincronizarea."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte Worldward úplný prístup ku Kalendáru v Nastavenia → Súkromie a zabezpečenie → Kalendáre a potom znova zapnite synchronizáciu."
          }
        },
        "sl" : {
          "stringUnit" : {
