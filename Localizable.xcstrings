    "Detects your current country and marks it with the chosen travel status." : {
      "comment" : "Description of the intent that marks the user's current location as visited.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открива текущата ви държава и я маркира с избрания пътнишески статус."
          }
        },
        "cs" : {
          "stringUnit" : {
