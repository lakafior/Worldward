    "Save a trip's packing list as a template to reuse it on future trips." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазване на списъка за опаковка на пътуване като шаблон за повторна употреба при бъдещи пътувания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložit balicí seznam výletu jako šablonu pro opětovné použití na budoucích cestách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en rejses pakkeliste som skabelon til genbrug på fremtidige rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Packliste einer Reise als Vorlage speichern, um sie auf zukünftigen Reisen wiederzuverwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε τη λίστα συσκευής ενός ταξιδιού ως πρότυπο για επαναχρησιμοποίηση σε μελλοντικά ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save a trip's packing list as a template to reuse it on future trips."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konservi la pakliston de vojaĝo kiel ŝablonon por reuzi ĝin por estontaj vojaĝoj."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar la lista de equipaje de un viaje como plantilla para reutilizarla en viajes futuros."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvesta reisi pakkimisnimekiri mallina, et seda tulevastel reisidel uuesti kasutada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna matkan pakkauslista malliksi käytettäväksi uudelleen tulevilla matkoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer la liste de bagages d'un voyage comme modèle pour la réutiliser lors de futurs voyages."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabháil liosta pacála turais mar theimpléad le hathúsáid ar thurais amach anseo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremi popis za pakiranje putovanja kao predložak za ponovno korištenje na budućim putovanjima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy út csomagolási listájának mentése sablonként a jövőbeli utakon való újrafelhasználáshoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva la lista bagagli di un viaggio come modello da riutilizzare per viaggi futuri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行のパッキングリストをテンプレートとして保存し、今後の旅行で再利用する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행의 집 꺹기 목록을 템플릿으로 저장하여 다음 여행에서 재사용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išsaugoti kelionės pakavimo sąrašą kaip šabloną, kad jį būtų galima naudoti pakartotinai būsimose kelionėse."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saglabāt ceļojuma iepakošanas sarakstu kā veidni, lai to atkārtoti izmantotu turpmākajos ceļojumos."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva l-lista tal-ippakkjar ta' vjaġġ bħala mudell biex tużaha mill-ġdid fi vjaġġi futuri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar de paklijst van een reis als sjabloon om deze te hergebruiken voor toekomstige reizen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz listę pakowania podróży jako szablon do ponownego użycia na przyszłych wyjazdach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar a lista de bagagem de uma viagem como modelo para reutilizar em viagens futuras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar a lista de bagagem de uma viagem como modelo para reutilizar em viagens futuras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvează lista de bagaje a unei călătorii ca șablon pentru a o reutiliza în călătorii viitoare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložiť baliaci zoznam výletu ako šablónu na opätovné použitie na budúcich cestách."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrani seznam pakiranja potovanja kot predlogo za ponovno uporabo na prihodnjih potovanjih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara en resas packlista som mall för att återanvända den på framtida resor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将旅行的收拾清单保存为模板，以便在未来旅行中重复使用。"
          }
        }
      }
    },
