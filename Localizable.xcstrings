    "Photos closer together than this are treated as one trip.": {
      "comment": "A description of how close photos must be to be merged into a single trip.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky blíže než toto jsou považovány za jednu cestu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die näher beieinander liegen, werden als eine Reise behandelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Photos closer together than this are treated as one trip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos más cercanas que esto se tratan como un solo viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos plus rapprochées que cela sont considérées comme un seul voyage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ennél közelebbi fotók egy utazásnak minősülnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto più vicine di così vengono trattate come un unico viaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これより近い写真は1つの旅行として扱われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이보다 가까운 사진은 하나의 여행으로 간주됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia zrobione bliżej siebie niż ta wartość są traktowane jako jedna podróż."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos mais próximas que isso são tratadas como uma única viagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos mais próximas que isso são tratadas como uma única viagem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky bližšie ako toto sú považované za jednu cestu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比这更近的照片将被视为同一次旅行。"
          }
        },
        "eo": {
          "stringUnit": {
