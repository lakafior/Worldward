    "A single trip at least this long marks the country as “Lived”." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Единично пътуване с поне тази продължителност отбелязва държавата като „Живяно“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna cesta v délce alespoň této doby označí zemi jako „Žil(a)“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enkelt rejse på mindst denne længde markerer landet som “Boet”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einzelne Reise dieser Mindestdauer markiert das Land als „Gelebt\"."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα μόνο ταξίδι αυτής της διάρκειας χαρακτηρίζει τη χώρα ως «Κατοικημένη»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A single trip at least this long marks the country as “Lived”."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unuopa vojaĝo tiom longa markas la landon kiel “Loĝis”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo viaje de al menos esta duración marca el país como «Vivido»."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üksik reis vähemalt nii kaua tähistab riiki kui “Elamas”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäinen matka, joka on vähintään näin pitkä, merkitsee maan asutuksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul voyage d’au moins cette durée marque le pays comme « Vécu »."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má mhaireann turas amháin chomh fada seo, marcáiltear an tír mar “Chónaigh” ann."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno putovanje u trajanju od najmanje toliko označava zemlju kao „Življeno“."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy ennyi ideig tartó utazás „Ott élt”-ként jelöli meg az országot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un singolo viaggio di almeno questa durata segna il paese come «Vissuto»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間以上の旅行が１回あれば、その国は「住んだ」とマークされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간 이상의 단일 여행이면 해당 국가가 “살아본”으로 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viena tokio ilgio kelionė pažymi šalį kaip “Gyveno”."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viens ceļojums šādā garumā atzīmē valsti kā “Dzīvojis”."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vjaġġ wieħed li jdum tal-inqas dan iż-żmien jimmarka l-pajjiż bħala “Għex”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een enkele reis van ten minste deze lengte markeert het land als “Gewoond”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojedyncza podróż trwająca co najmniej tyle oznacza kraj jako „Mieszkałem”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma única viagem de pelo menos esta duração marca o país como «Morei»."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma única viagem de pelo menos esta duração marca o país como «Morei»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O singură excursie de cel puțin această durată marchează țara ca „Trăită”."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna cesta v trvaní aspoň tohto času označí krajinu ako „Žil(a)“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sam izlet v trajanju vsaj toliko označi državo kot »Živeto«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enskild resa på minst denna längd markerar landet som “Bodde”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次旅行达到此时长即将该国标记为“居住过”。"
          }
        }
      }
    },
