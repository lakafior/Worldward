    "Visit a few more places first — then we can spot the gaps on your map." : {
      "comment" : "Empty state for the 'Fill a gap' suggestion mode",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посетете още няколко места — тогава ще открием празнините на картата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navštivte ještě pár míst — pak odhalíme mezery na vaší mapě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besøg et par steder først — så kan vi finde hullerne på dit kort."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besuche zuerst noch ein paar Orte — dann können wir die Lücken auf deiner Karte erkennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επισκεφθείτε πρώτα μερικά ακόμη μέρη — και θα εντοπίσουμε τα κενά στον χάρτη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Visit a few more places first — then we can spot the gaps on your map."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vizitu ankoraŭ kelkajn lokojn — tiam ni povos ekvidi la breĉojn sur via mapo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita algunos lugares más — entonces podremos detectar los huecos en tu mapa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Külasta veel mõnda kohta — siis saame kaardil lüngad tuvastada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käy ensin muutamassa paikassa — sitten voimme havaita aukot kartallasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visitez encore quelques endroits — puis nous pourrons repérer les lacunes sur votre carte."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabhair cuairt ar chúpla áit eile ar dtús — ansin feicfimid na bearnaí ar do léarscáil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posjeti još nekoliko mjesta — tada možemo uočiti praznine na tvojoj karti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Látogass meg még néhány helyet — aztán észrevehetjük a hézagokat a térképeden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita ancora qualche posto — poi potremo individuare i vuoti sulla tua mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずいくつかの場所を訪れてください — そうすればマップ上の空白を見つけられます。"
