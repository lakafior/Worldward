    "Photos closer together than this are treated as one trip.": {
      "comment": "A description of how close photos must be to be merged into a single trip.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky blíže než toto jsou považovány za jednu cestu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die näher beieinander liegen, werden als eine Reise behandelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Photos closer together than this are treated as one trip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos más cercanas que esto se tratan como un solo viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos plus rapprochées que cela sont considérées comme un seul voyage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ennél közelebbi fotók egy utazásnak minősülnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto più vicine di così vengono trattate come un unico viaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これより近い写真は1つの旅行として扱われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이보다 가까운 사진은 하나의 여행으로 간주됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia zrobione bliżej siebie niż ta wartość są traktowane jako jedna podróż."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos mais próximas que isso são tratadas como uma única viagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos mais próximas que isso são tratadas como uma única viagem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky bližšie ako toto sú považované za jednu cestu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比这更近的照片将被视为同一次旅行。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoj pli proksimaj ol ĉi tio estas traktataj kiel unu vojaĝo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder tættere på hinanden end dette behandles som én rejse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Foton som är närmare varandra än detta behandlas som en resa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat, jotka ovat tätä lähempänä toisiaan, käsitellään yhtenä matkana."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotosid, mis on üksteisele lähemal kui see, käsitletakse ühe reisina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's die dichter bij elkaar zijn dan dit worden als één reis behandeld."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимките, по-близки една до друга от това, се считат за едно пътуване."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije bliže od ove smatraju se jednim putovanjem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες που απέχουν λιγότερο από αυτό θεωρούνται ως ένα ταξίδι."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile mai apropiate decât aceasta sunt tratate ca o singură călătorie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije, ki so bližje skupaj od tega, se obravnavajo kot eno potovanje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogrāfijas, kas ir tuvāk viena otrai nekā šī, tiek uzskatītas par vienu ceļojumu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuotraukos, esančios arčiau viena kitos nei šis atstumas, laikomos viena kelione."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Déileálfar le grianghraif atá níos gaire dá chéile ná seo mar thuras amháin."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritratti eqreb minn dan jitqiesu bħala vjaġġ wieħed."
          }
        }
      }
    },
    "Plan your next adventure — tap ＋ to start a trip.": {
      "comment": "A description of the content of the \"No trips yet\"",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plánujte své další dobrodružství — klepněte na + a začněte cestu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane dein nächstes Abenteuer – tippe auf ＋, um eine Reise zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Plan your next adventure — tap ＋ to start a trip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica tu próxima aventura — toca ＋ para iniciar un viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez votre prochaine aventure — appuyez sur ＋ pour commencer un voyage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervezze meg következő kalandját — érintse meg a + jelet egy utazás indításához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica la tua prossima avventura — tocca ＋ per iniziare un viaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の冒険を計画しましょう — ＋をタップして旅行を開始。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 모험을 계획하세요 — + 를 탭하여 여행을 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanuj swoją następną przygodę — dotknij ＋, aby rozpocząć podróż."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje sua próxima aventura — toque em ＋ para iniciar uma viagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje sua próxima aventura — toque em ＋ para iniciar uma viagem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plánujte svoje ďalšie dobrodružstvo — klepnite na + a začnite cestu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划您的下一次冒险——点击 + 开始一次旅行。"
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Planu vian sekvan aventuron — frapetu + por komenci vojaĝon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlæg dit næste eventyr — tryk på + for at starte en rejse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planera ditt nästa äventyr — tryck på + för att starta en resa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnittele seuraava seikkailusi — napauta + aloittaaksesi matkan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeeri oma järgmine seiklus — vajuta + reisi alustamiseks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan je volgende avontuur — tik op + om een reis te starten."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Планирайте следващото си приключение — докоснете и започнете пътуване."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planirajte svoju sljedeću avanturu — dodirnite + za početak putovanja."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε την επόμενη περιπέτειά σας — πατήστε + για να ξεκινήσετε ένα ταξίδι."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planificați următoarea aventură — atingeți + pentru a începe o călătorie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Načrtujte svojo naslednjo pustolovščino — dotaknite se + za začetek potovanja."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plānojiet savu nākamo piedzīvojumu — pieskarieties ＋, lai sāktu ceļojumu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suplanuokite savo kitą nuotykį — bakstelėkite ＋, kad pradėtumėte kelionę."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Pleanáil do chéad eachtra eile — tapáil ＋ chun turas a thosú."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ippjana l-avventura li jmiss tiegħek — tektek ＋ biex tibda vjaġġ."
          }
        }
      }
    },
