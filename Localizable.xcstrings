    "Ask me anything about the countries you've visited — on-device, private to you." : {
      "comment" : "A description of the functionality of the Travel Chat view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Питайте ме всичко за посетените от вас държави — на устройството, лично за вас."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptejte se na cokoli o zemích, které jste navštívili — zpracováno na zařízení, soukromé jen pro vás."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg mig om alt vedrørende de lande du har besøgt — på enheden, privat for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mich alles zu den Ländern, die du besucht hast – auf dem Gerät, privat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρωτήστε με οτιδήποτε για τις χώρες που έχετε επισκεφτεί — στη συσκευή, ιδιωτικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ask me anything about the countries you've visited — on-device, private to you."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandu min ion ajn pri la landoj kiujn vi vizitis — sur aparato, private nur por vi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntame lo que quieras sobre los países que has visitado — en el dispositivo, privado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küsi minult kõike riikide kohta, mida oled külastanud — seadmes, privaatselt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy minulta mitä tahansa vierailemistasi maista — laitteella, yksityisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez-moi tout sur les pays que vous avez visités — sur l’appareil, en toute confidentialité."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiafraigh díom faoi na tíortha ar thug tú cuairt orthu — ar an ngléas, príobháideach duit."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitajte me sve o državama koje ste posjetili — na uređaju, privatno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérdezzen bármit a meglátogatott országokról — az eszközén történik, csak Ön látja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedimi tutto sui paesi che hai visitato — sul dispositivo, privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪れた国について何でも質問してください — デバイス上で処理され、あなただけにプライベートです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방문한 국가에 관해 무엇이나 묻어보세요 — 기기 내에서 처리되며, 당신만의 개인정보로 남습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klauskite bet ko apie šalis, kurias aplankėte — įrenginyje, privačiai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jautājiet jebko par valstīm, kuras esat apmeklējis — ierīcē, privāti."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staqsini dwar kwalunkwe pajjiż żort — fuq it-tagħmir, privat għalik."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag me alles over de landen die je hebt bezocht — op het apparaat, privé."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj o wszystko dotyczące krajów, które odwiedziłeś — na urządzeniu, prywatnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte-me qualquer coisa sobre os países que você visitou — no dispositivo, privado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte-me qualquer coisa sobre os países que você visitou — no dispositivo, privado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întrebați-mă orice despre țările pe care le-ați vizitat — pe dispozitiv, confidențial."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spýtajte sa na čokoľvek o krajinách, ktoré ste navštívili — spracované na zariadení, súkromné len pre vás."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vprašajte me karkoli o državah, ki ste jih obiskali — na napravi, zasebno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga mig vad som helst om länderna du har besökt — på enheten, privat för dig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽管问我您去过的国家——在设备上处理，仅属于您个人隐私。"
          }
        }
      }
