    "Describe a trip in your own words and Worldward extracts the countries and dates for you to confirm." : {
      "comment" : "Description of the intent that lets the user describe a trip and Worldward extracts the countries and dates for them to confirm.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опишете пътуване с собствени думи и Worldward извлича държавите и датите за потвърждане."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popište cestu vlastními slovy a Worldward extrahuje země a data k potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv en rejse med dine egne ord, og Worldward udtrækker landene og datoerne, så du kan bekræfte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe eine Reise in eigenen Worten und Worldward extrahiert die Länder und Daten zur Bestätigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιγράψτε ένα ταξίδι με δικά σας λόγια και το Worldward εξάγει τις χώρες και ημερομηνίες για επιβεβαίωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Describe a trip in your own words and Worldward extracts the countries and dates for you to confirm."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priskribu vojaĝon per viaj propraj vortoj kaj Worldward eltiras la landojn kaj datojn por vi konfirmi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe un viaje con tus propias palabras y Worldward extrae los países y fechas para que los confirmes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjelda reisi oma sõnadega ja Worldward eraldab riigid ja kuupäevad, et saaksid kinnitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvaile matka omin sanoin, ja Worldward poimii maat ja päivämäärät vahvistettavaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez un voyage avec vos propres mots et Worldward extrait les pays et les dates pour confirmation."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déan cur síos ar thuras i do fhocail féin agus baineann Worldward na tíortha agus na dátaí amach duit le deimhniú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opišite putovanje vlastitim riječima, a Worldward izvlači države i datume za potvrdu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írja le az utazást a saját szavaival, és a Worldward kinyeri az országokat és dátumokat a megerősítéshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi un viaggio con le tue parole e Worldward estrae i paesi e le date da confermare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行を自分の言葉で説明すると、Worldwardが国と日付を抽出して確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행을 스스로 설명하면 Worldward가 국가와 날짜를 추출하여 확인할 수 있게 해줍니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprašykite kelionę savais žodžiais, o Worldward ištrauks šalis ir datas patvirtinimui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprakstiet ceļojumu saviem vārdiem, un Worldward izvelk valstis un datumus, lai jūs apstiprinātu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iddeskrivi vjaġġ bil-kliem tiegħek u Worldward jestratt l-pajjiżi u d-dati biex tikkonferma."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf een reis in je eigen woorden en Worldward haalt de landen en data eruit die je kunt bevestigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz podróż własnymi słowami, a Worldward wyodrębni kraje i daty do potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva uma viagem com suas próprias palavras e o Worldward extrai os países e datas para você confirmar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
