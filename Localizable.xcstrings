    "Search for sights and spots to visit at this stop." : {
      "comment" : "A description of the search field in the place chooser.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търсете забележителности и места за посещение на тази спирка."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledejte památky a místa k návštěvě na této zastávce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg efter seværdigheder og steder at besøge ved dette stop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
