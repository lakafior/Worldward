        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 몇 군데를 더 방문하세요 — 그러면 지도에서 빈 곳을 찾을 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplankyk dar kelias vietas — tada galėsime pastebėti spragas tavo žemėlapyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apmeklē vēl dažas vietas — tad varēsim pamanīt robus tavā kartē."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żur ftit postijiet oħra l-ewwel — imbagħad nistgħu naraw il-vojt fuq il-mappa tiegħek."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezoek eerst nog een paar plekken — dan kunnen we de gaten op je kaart vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
