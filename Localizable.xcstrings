    "These photos carry no location metadata — check they're really from the trip before adding." : {
      "comment" : "A footer for the section of the trip photo suggestions",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези снимки нямат метаданни за местоположение — проверете, че наистина са от пътуването, преди да ги добавите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto fotografie nemají žádná metadata o poloze — před přidáním zkontrolujte, že skutečně pocházejí z cesty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse fotos har ingen lokaliseringsmetadata — kontrollér, at de virkelig er fra rejsen, før du tilføjer dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fotos haben keine Ortsmetadaten — prüfen Sie, ob sie wirklich von der Reise stammen, bevor Sie sie hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι φωτογραφίες δεν φέρουν μεταδεδομένα τοποθεσίας — ελέγξτε ότι προέρχονται πραγματικά από το ταξίδι πριν τις προσθέσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These photos carry no location metadata — check they're really from the trip before adding."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiuj ĉi fotoj ne havas lokajn metadatumojn — kontrolu ke ili vere estas de la vojaĝo antaŭ ol aldoni."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos no tienen metadatos de ubicación — verifica que realmente sean del viaje antes de añadirlas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nendel fotodel puuduvad asukohametaandmed — enne lisamist kontrollige, kas need on tõesti reisilt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näissä valokuvissa ei ole paikkatietoja — tarkista, että ne ovat todella matkalta ennen lisäämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces photos ne comportent pas de métadonnées de localisation — vérifiez qu’elles proviennent bien du voyage avant de les ajouter."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl aon mheiteashonraí suímh ag na grianghraif seo — seiceáil gur ón turas iad i ndáiríre sula gcuireann tú leo."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ove fotografije nemaju metapodatke o lokaciji — prije dodavanja provjerite jesu li stvarno s putovanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a fényképek nem tartalmaznak helyadatokat — ellenőrizze, hogy tényleg az utazásról származnak-e, mielőtt hozzáadja őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste foto non hanno metadati di posizione — verifica che siano davvero del viaggio prima di aggiungerle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの写真には位置情報がありません — 添付する前に旅行からのものか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진에는 위치 메타데이터가 없습니다 — 추가하기 전에 정말 여행 사진인지 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šios nuotraukos neturi vietos metaduomenų — prieš pridėdami patikrinkite, ar jos tikrai iš kelionės."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiem fotoattēliem nav atrašanās vietas metadatu — pirms pievienošanas pārbaudiet, vai tie patiešām ir no ceļojuma."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawn ir-ritratti m'għandhomx metadejta tal-post — iċċekkja li huma verament mill-vjaġġ qabel iżżdulhom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze foto’s hebben geen locatiemetagegevens — controleer of ze echt van de reis zijn voordat je ze toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te zdjęcia nie mają metadanych lokalizacji — przed dodaniem sprawdź, czy naprawdę pochodzą z podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos não têm metadados de localização — verifique se são mesmo da viagem antes de adicioná-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos não têm metadados de localização — verifique se são mesmo da viagem antes de as adicionar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste fotografii nu au metadate de locație — verificați că sunt într-adevăr din călătorie înainte de a le adăuga."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto fotografie nenesú žiadne metadáta o polohe — pred pridaním skontrolujte, či sú naozaj z cesty."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te fotografije nimajo metapodatkov o lokaciji — preden jih dodate, preverite, da so res s potovanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa foton har ingen platsmetadata — kontrollera att de verkligen är från resan innan du lägger till dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些照片没有位置元数据 — 在添加前确认它们确实是从这次旅行中拍摄的。"
          }
        }
      }
    },
    "These photos didn't fall inside any country — often a small island. Assign each to a country, or leave it to skip those photos." : {
      "comment" : "A description of the footer for the list of locations that haven't been assigned to a country.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тези снимки не попадат в никоя държава — често малък остров. Присвоете всеки към държава или оставете за прескакане."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto fotky neleží v žádné zemi — často malý ostrov. Přiřaďte každou k zemi, nebo ji ponechte pro přeskočení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse billeder lå ikke inden for noget land — ofte en lille ø. Tildel hvert til et land, eller lad det være for at springe de billeder over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fotos liegen in keinem Land – oft eine kleine Insel. Ordne jedes einem Land zu oder lasse sie aus, um die Fotos zu überspringen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι φωτογραφίες δεν βρίσκονται εντός κάποιας χώρας — συχνά ένα μικρό νησί. Αναθέστε κάθε μια σε μια χώρα ή αφήστε την για να παρακαμφθούν αυτές οι φωτογραφίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These photos didn't fall inside any country — often a small island. Assign each to a country, or leave it to skip those photos."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ĉi tiuj fotoj ne estas ene de iu lando — ofte malgranda insulo. Atribuu ĉiun al lando, aŭ lasu por preterpasi tiujn fotojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos no caen dentro de ningún país — a menudo una isla pequeña. Asigna cada una a un país, o déjalas para saltar esas fotos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need fotod ei langenud ühegi riigi sisse — sageli väike saar. Määra igaüks riigile või jäta need fotod vahele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä kuvat eivät osuneet minkään maan sisään — usein pieni saari. Määrää kukin maahan tai jätä ohittaaksesi nämä kuvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces photos ne se situent dans aucun pays — souvent une petite île. Attribuez chacune à un pays, ou laissez pour ignorer ces photos."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níor thit na grianghraif seo laistigh d'aon tír — oileán beag go minic. Sann gach ceann do thír, nó fág é chun na grianghraif sin a scipeáil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ove fotografije ne pripadaju nijednoj državi — često mali otok. Dodijelite svaku državi ili ostavite da ih preskočite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a fotók nem esnek egyetlen országon belülre sem — gyakran egy kis sziget. Rendeljen hozzá mindegyiket egy országhoz, vagy hagyja őket kihagyásra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste foto non cadono all’interno di alcun paese — spesso una piccola isola. Assegna ciascuna a un paese o lascia per saltare quelle foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの写真はどの国内にも位置していません—小さな島であることがよくあります。各写真を国に割り当てるか、そのままにしてスキップすることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진은 어떤 국가 안에 위치하지 않습니다 — 보통 작은 섬입니다. 각 사진을 국가에 할당하거나 두어서 스킵하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šios nuotraukos nepatenka į jokią šalį — dažnai maža sala. Priskirkite kiekvieną šaliai arba palikite, kad praleistumėte šias nuotraukas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šīs fotogrāfijas neatrodas nevienas valsts teritorijā — bieži maza saliņa. Piešķiriet katru valstij vai atstājiet, lai izlaistu šīs fotogrāfijas."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawn ir-ritratti ma waqgħux f'ebda pajjiż — spiss gżira żgħira. Assenja kull wieħed lil pajjiż, jew ħallih biex taqbeż dawk ir-ritratti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze foto's vielen niet binnen een land — vaak een klein eiland. Wijs elk aan een land toe, of laat het staan om deze foto's over te slaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te zdjęcia nie znajdują się w granicach żadnego kraju — często to mała wyspa. Przypisz każde do kraju lub pozostaw, aby pominąć te zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos não estão dentro de nenhum país — muitas vezes uma pequena ilha. Atribua cada uma a um país, ou deixe para pular essas fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos não estão dentro de nenhum país — muitas vezes uma pequena ilha. Atribua cada uma a um país, ou deixe para pular essas fotos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste fotografii nu se încadrează în nicio țară — de obicei o insulă mică. Atribuiți fiecare unei țări sau lăsați pentru a sări peste acele fotografii."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto fotky neležia v žiadnej krajine — často malý ostrov. Priraďte každú ku krajine, alebo ju ponechajte na preskočenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te fotografije ne spadajo v nobeno državo — pogosto majhen otok. Dodelite vsako državi ali pustite, da preskočite te fotografije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa foton låg inte inom något land — ofta en liten ö. Tilldela varje till ett land, eller låt bli för att hoppa över dessa foton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些照片不在任何国家境内——通常是小岛屿。将每张照片分配到国家，或留空以跳过这些照片。"
          }
        }
      }
    },
