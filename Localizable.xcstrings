    "Your country count and share of the world, on the Lock Screen." : {
      "comment" : "Lock Screen accessory widget description",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Броят на държавите и делът ви от света, на заключения екран."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet zemí a podíl na světě na zamykací obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit antal lande og din andel af verden på låseskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Länderzahl und dein Anteil an der Welt auf dem Sperrbildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο αριθμός χωρών και το μερίδιό σας στον κόσμο, στην οθόνη κλειδώματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your country count and share of the world, on the Lock Screen."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via landnombro kaj parto de la mondo, sur la ŝlosila ekrano."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu recuento de países y parte del mundo, en la pantalla de bloqueo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu riikide arv ja osa maailmast lukustuskuval."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maittesi lukumäärä ja osuutesi maailmasta lukitusnäytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nombre de pays et part du monde, sur l'écran de verrouillage."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do chomhaireamh tíortha agus do sciar den domhan, ar an scáileán glasála."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš broj zemalja i udio u svijetu na zaključanom zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az országok száma és a világból való részesedésed a zárolási képernyőn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo numero di paesi e la tua parte di mondo, sulla schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの国数と世界のシェアをロック画面に表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 국가 수와 세계 비율을 잠금 화면에서 확인하세요."
