    "Try naming the countries you visited more directly.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste jmenovat země, které jste navštívili, příměji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, die besuchten Länder direkter zu nennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Try naming the countries you visited more directly."
          }
        },
        "es": {
          "stringUnit": {
