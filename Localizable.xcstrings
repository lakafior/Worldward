    "Worldward doesn't have calendar access. Turn it on in Settings to add trips." : {
      "comment" : "Alert message when Apple Calendar access has been denied",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward няма достъп до календара. Включете го в Настройки за добавяне на пътувания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward nemá přístup ke kalendáři. Povolte jej v Nastavení pro přidávání cest."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward har ikke adgang til kalender. Slå det til i Indstillinger for at tilføje rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward hat keinen Kalenderzugriff. Schalte ihn in den Einstellungen ein, um Reisen hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Worldward δεν έχει πρόσβαση στο ημερολόγιο. Ενεργοποιήστε το στις Ρυθμίσεις για να προσθέτετε ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Worldward doesn't have calendar access. Turn it on in Settings to add trips."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward ne havas aliron al kalendaro. Ŝaltu ĝin en Agordoj por aldoni vojaĝojn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward no tiene acceso al calendario. Actívalo en Ajustes para añadir viajes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldwardil pole kalendrijuurdepääsu. Lülita see sisse Seadetes, et reise lisada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldwardilla ei ole kalenterin käyttöoikeutta. Ota se käyttöön Asetuksissa lisätäksesi matkoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward n'a pas accès au calendrier. Activez-le dans Réglages pour ajouter des voyages."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl rochtain ag Worldward ar an bhféilire. Cas air i Socruithe chun turais a chur leis."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward nema pristup kalendaru. Uključi ga u Postavkama za dodavanje putovanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Worldwardnak nincs hozzáférése a naptárhoz. Kapcsold be a Beállításokban az utazások hozzáadásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward non ha accesso al calendario. Attivalo in Impostazioni per aggiungere viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldwardはカレンダーにアクセスできません。設定でオンにして旅行を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward가 캘린더에 접근할 수 없습니다. 설정에서 켜서 여행을 추가하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward neturi prieigos prie kalendoriaus. Įjunk jį Nustatymuose, kad pridėtum keliones."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward nav piekļuves kalendāram. Ieslēdz to Iestatījumos, lai pievienotu ceļojumus."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward m'għandux aċċess għall-kalendarju. Ixgħelha fl-Issettjar biex iżżid vjaġġi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward heeft geen toegang tot de agenda. Schakel dit in bij Instellingen om reizen toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward nie ma dostępu do kalendarza. Włącz go w Ustawieniach, aby dodawać podróże."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Worldward não tem acesso ao calendário. Ative-o em Ajustes para adicionar viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Worldward não tem acesso ao calendário. Ative-o nas Definições para adicionar viagens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward nu are acces la calendar. Activează în Setări pentru a adăuga călătorii."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward nemá prístup ku kalendáru. Povoľte ho v Nastaveniach na pridávanie ciest."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward nima dostopa do koledarja. Vklopi ga v Nastavitvah za dodajanje potovanj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward har inte kalenderåtkomst. Aktivera det i Inställningar för att lägga till resor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward 没有日历访问权限。请在设置中打开以添加旅行。"
          }
        }
      }
    },
    "Worldward needs to restart to switch languages." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worldward трябва да се рестартира, за да смени езика."
