    "Occasional on-device reminders: “on this day” travel memories, a year-in-review nudge each December, and a gentle prompt if you haven't logged a trip in a while." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Случайни напомняния на устройството: спомени от пътувания „на този ден“, годишен преглед всеки декември и деликатна подкана, ако не сте записвали пътуване от известно време."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příležitostné připomínky v zařízení: cestovní vzpomínky „přesně v tento den“, shrnutí roku každý prosinec a jemná výzva, pokud jste delší dobu nezaznamenali žádnou cestu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejlighedsvise påmindelser på enheden: rejseminder „på denne dag“, et årsoversigt hver december og en blid påmindelse, hvis du ikke har logget en rejse i et stykke tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelegentliche Erinnerungen auf dem Gerät: „An diesem Tag“-Reiseerinnerungen, ein Jahresrückblick jeden Dezember und eine sanfte Aufforderung, wenn du länger keine Reise erfasst hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περιστασιακές υπενθυμίσεις στη συσκευή: ταξιδιωτικές αναμνήσεις «τέτοια μέρα», μια ετήσια ανασκόπηση κάθε Δεκέμβριο και μια διακριτική υπενθύμιση αν δεν έχετε καταγράψει κάποιο ταξίδι εδώ και καιρό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Occasional on-device reminders: “on this day” travel memories, a year-in-review nudge each December, and a gentle prompt if you haven't logged a trip in a while."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okazaj memorigoj sur la aparato: vojaĝmemoroj „en ĉi tiu tago“, jara resumo ĉiun decembron kaj milda memorigo se vi longe ne registris vojaĝon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorios ocasionales en el dispositivo: recuerdos de viaje «en este día», un resumen anual cada diciembre y un aviso amable si no has registrado un viaje en un tiempo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juhuslikud meeldetuletused seadmes: reisimälestused „sel päeval“, aasta kokkuvõte igal detsembril ja õrn meeldetuletus, kui te pole mõnda aega reisi sisse kandnud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satunnaisia muistutuksia laitteella: matkamuistoja „tänä päivänä“, vuosikatsaus joka joulukuu ja lempeä muistutus, jos et ole kirjannut matkaa vähään aikaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappels occasionnels sur l'appareil : les souvenirs de voyage « à cette date », un bilan annuel chaque décembre et une invitation discrète si vous n'avez pas enregistré de voyage depuis un moment."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meabhrúcháin ócáideacha ar an ngléas: cuimhní taistil „ar an lá seo“, meabhrúchán bliantúil gach Nollaig, agus leidín réidh mura ndearna tú turas a logáil le tamall."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povremene obavijesti na uređaju: putna sjećanja „na današnji dan“, godišnji pregled svakog prosinca i nježan podsjetnik ako već neko vrijeme niste zabilježili putovanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkalmankénti értesítések az eszközön: „ezen a napon“ utazási emlékek, éves összefoglaló minden decemberben és egy finom emlékeztető, ha rég nem rögzített utat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria occasionali sul dispositivo: ricordi di viaggio «in questo giorno», un riepilogo annuale ogni dicembre e un invito discreto se non registri un viaggio da un po'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上のときどきのリマインダー: 「この日に」旅行の思い出、毎年12月の年間まとめ、しばらく旅行を記録していないときのやさしいお知らせ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에서 가끔 알림: “오늘 이 날” 여행 추억, 매년 12월 연간 리뷰, 그리고 한동안 여행을 기록하지 않았을 때의 부드러운 안내입니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retkarčiais pasirodantys priminimai įrenginyje: kelionių prisiminimai „šią dieną“, metų apžvalga kiekvieną gruodį ir švelnus raginimas, jei kurį laiką neužregistravote jokios kelionės."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neregulāri atgādinājumi ierīcē: ceļojumu atmiņas „šajā dienā“, gada pārskats katru decembri un maigs atgādinājums, ja kādu laiku neesat reģistrējis ceļojumu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tfakkir okkażjonali fuq l-apparat: memorji tal-ivvjaġġar „f'dan il-jum“, sommarju annwali kull Diċembru, u tfakkira ġentili jekk ma rreġistrajtx vjaġġ għal xi żmien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af en toe herinneringen op je apparaat: reisherinneringen „op deze dag“, een jaaroverzicht elke december en een zachte aanmoediging als je al een tijdje geen reis hebt vastgelegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okazjonalne przypomnienia na urządzeniu: wspomnienia z podróży „w tym dniu“, podsumowanie roku każdego grudnia i delikatny komunikat, jeśli od jakiegoś czasu nie zapisałeś żadnej podróży."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembretes ocasionais no dispositivo: memórias de viagem «neste dia», um resumo anual todo mês de dezembro e um aviso gentil se você não registrar uma viagem há algum tempo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembretes ocasionais no dispositivo: memórias de viagem «neste dia», um resumo anual todos os dezembros e um aviso gentil se não registar uma viagem há algum tempo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mementouri ocazionale pe dispozitiv: amintiri de călătorie „în această zi“, un rezumat anual în fiecare decembrie și o invitație blândă dacă nu ați înregistrat o călătorie de ceva timp."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príležitostné pripomienky v zariadení: cestovné spomienky „presne v tento deň“, ročné zhrnutie každý december a jemná výzva, ak ste dlhší čas nezaznamenali žiadnu cestu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Občasni opomniki v napravi: potovalni spomini „na današnji dan“, letni pregled vsak december in nežen poziv, če že nekaj časa niste zabeležili potovanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enstaka påminnelser på enheten: reseminnen „just denna dag“, en årsöversikt varje december och en varsam påminnelse om du inte har loggat en resa på ett tag."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偶尔在设备上提醒：“这一天”的旅行回忆、每年 12 月的年度回顾，以及当您一段时间未记录旅行时的温和提示。"
          }
        }
      }
    },
