    "Could not determine your current country from your location." : {
      "comment" : "Error message when the app can't determine the user's location.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не може да се определи текущата ви държава от местоположението ви."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z vaší polohy nelze určit vaši aktuální zemi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke bestemme dit nuværende land ud fra din placering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein aktuelles Land konnte nicht anhand deines Standorts ermittelt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατός ο προσδιορισμός της τρέχουσας χώρας από τη θέση σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not determine your current country from your location."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne eblis determini vian nunan landon laŭ via loko."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo determinar tu país actual desde tu ubicación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei suutnud sinu asukoha põhjal määrata sinu praegust riiki."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyistä maatasi ei voitu päätellä sijainnistasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déterminer votre pays actuel depuis votre position."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níorbh fhéidir do thír reatha a chinneadh ó do shuíomh."
